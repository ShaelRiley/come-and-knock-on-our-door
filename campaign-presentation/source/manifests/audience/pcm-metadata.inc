(procedure (pmReaction beat field index &tmp row base)
 (if (or (< field 0) (> field 7) (< index 0)) (return -1))
 (for ((= row 0)) (< row 9) ((++ row))
  (= base (* row 9))
  (if (== beat [pmReactionRows base])
   (if (== field 6)
    (if (< index [pmReactionRows (+ base 6)]) (return [pmEligibleTakes (+ [pmReactionRows (+ base 7)] index)])) (return -1))
   (if index (return -1))
   (return [pmReactionRows (+ base (if (== field 7) 8 else (+ field 1)))]))) (return -1))

(procedure (pmTake takeId field derivative &tmp row base)
 (if (or (< field 0) (> field 8) derivative) (return -1))
 (for ((= row 0)) (< row 55) ((++ row))
  (= base (* row 10))
  (if (== takeId [pmTakeRows base]) (return [pmTakeRows (+ base (+ field 1))]))) (return -1))

(procedure (pmFoley sourceScript event arg0 arg1 field index &tmp row base)
 (if (or (< field 0) (> field 5) (< index 0)) (return -1))
 (for ((= row 0)) (< row 83) ((++ row))
  (= base (* row 11))
  (if (and (== sourceScript [pmFoleyRows base]) (== event [pmFoleyRows (+ base 1)])
   (or (== [pmFoleyRows (+ base 2)] 32767) (== arg0 [pmFoleyRows (+ base 2)]))
   (or (== [pmFoleyRows (+ base 3)] 32767) (== arg1 [pmFoleyRows (+ base 3)])))
   (if (== field 4) (if (< index [pmFoleyRows (+ base 7)]) (return [pmFoleyRows (+ base (+ 8 index))])) (return -1))
   (if index (return -1))
   (return [pmFoleyRows (+ base (if (== field 5) 10 else (+ field 4)))]))) (return -1))

(procedure (psIntent host &tmp p room)
 (if (== psMode 4) (return 121))
 (if psEnded (return 0))
 (= p (ScriptID 996 0))
 (if (p p14Ready:) (return (if (>= (p p14Phase?) 5) 121 else 119)))
 (= p (ScriptID 995 0))
 (if (p p13Present: 1) (return (if (p p13Ready:) 118 else 117)))
 (= p (ScriptID 994 0))
 (if (p p12Present: 1)
  (if (or (== (p p12PresentationSource?) 9) (and (p p12Present: 16) (not (p p12Complete: 9)))) (return 129))
  (if (and (p p12Ready:) (p p12Complete: 9)) (return 116))
  (return 115))
 (= p (ScriptID 993 0))
 (if (p p11Present: 1) (return (if (p p11SincereComplete:) 114 else 113)))
 (if (or [psFacts 5] [psFacts 6])
  (return (if (or [psFacts 7] [psFacts 8] [psFacts 9] [psFacts 10]) 112 else 111)))
 (if (not (host p02PlanAgreed?)) (return 101))
 (= room (host location?))
 (switch room (0 (return 104)) (1 (return (if (host onApron?) 120 else 102)))
  (2 (return 103)) (3 (return 105)) (4 (return 106))
  (5 (return (if (& [psFacts 4] 2) 108 else 107)))
  (6 (return (if [psFacts 3] 110 else 109))))

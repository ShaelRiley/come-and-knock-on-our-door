(procedure (psConsume source event hi lo &tmp slot bit)
 (= slot (* (- source 993) 3))
 (if (or (< hi [psReceipts slot]) (and (== hi [psReceipts slot]) (< lo [psReceipts (+ slot 1)]))) (return 0))
 (if (or (> hi [psReceipts slot]) (> lo [psReceipts (+ slot 1)]))
  (= [psReceipts slot] hi) (= [psReceipts (+ slot 1)] lo) (= [psReceipts (+ slot 2)] 0))
 (if (or (< event 1) (> event 15)) (return 0))
 (= bit (<< 1 (- event 1)))
 (if (& [psReceipts (+ slot 2)] bit) (return 0))
 (= [psReceipts (+ slot 2)] (| [psReceipts (+ slot 2)] bit)) (return 1))
(procedure (psLedgerValid &tmp i slot hi lo d currentHi currentLo)
 (if (or (< psDirty 0) (> psDirty 1) (< psEnded 0) (> psEnded 1)
  (not (or (== psPassage 0) (== psPassage 128)))
  (and psCue (or (< psRow 0) (>= psRow (pmCue psCue 6 0))))) (return 0))
 (for ((= i 0)) (< i 5) ((++ i))
  (= slot (* i 3)) (= hi [psReceipts slot]) (= lo [psReceipts (+ slot 1)])
  (if (or (< hi 0) (< lo 0) (< [psReceipts (+ slot 2)] 0)
   (and (== hi 0) (== lo 0) [psReceipts (+ slot 2)])) (return 0))
  (= d (ScriptID (+ i 993) 0))
  (switch i
   (0 (= currentHi (d p11RevisionHi?)) (= currentLo (d p11RevisionLo?)))
   (1 (= currentHi (d p12RevisionHi?)) (= currentLo (d p12RevisionLo?)))
   (2 (= currentHi (d p13RevisionHi?)) (= currentLo (d p13RevisionLo?)))
   (3 (= currentHi (d p14RevisionHi?)) (= currentLo (d p14RevisionLo?)))
   (4 (= currentHi (d p14RevisionHi?)) (= currentLo (d p14RevisionLo?))))
  (if (or (> hi currentHi) (and (== hi currentHi) (> lo currentLo))) (return 0)))
 (return 1))

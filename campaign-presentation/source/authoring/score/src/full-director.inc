(procedure (psResolve host reason &tmp target row)
 (if (or (== psMode 1) (== psMode 2) (host opening?)) (return 1))
 (= target (psIntent host))
 (if (not target) (= psDirty 0) (return 1))
 (if (and (>= (rbStatus 2) 152) (== (rbStatus 2) 152) (not (rbStatus 15)))
  (= target (+ 140 (if ((ScriptID 985 0) hVCThinking?) 5 else (rbStatus 9)))))
 (if psPassage (= target psPassage))
 (= row (if (and (>= target 140) (<= target 145)) (- target 140)
  else (if (and (> (pmCue target 6 0) 1)
   (or (host onApron?) (and (== target 103) [psFacts 22])
    (and (== target 105) (or [psFacts 20] [psFacts 21]))
    (and (== target 106) [psFacts 23]))) 1 else 0)))
 (if (and (== target psCue) (== row psRow)) (= psDirty 0) (return 1))
 (if (not (rbScoreRequest target row reason)) (return 0))
 (= psCue target) (= psRow row) (= psDirty 0)
 (if (and (or (== target 119) (== target 121)) (!= psMode 4)) (= psMode 3))
 (return 1))
(procedure (psEventValid source event hi lo a b &tmp d i count)

(procedure (pmCue cue field index &tmp i base)
 (if (or (< field 0) (> field 9) (< index 0) (and (!= field 9) (!= index 0))) (return -1))
 (for ((= i 0)) (< i @CUE_COUNT@) ((++ i))
  (= base (* i 10))
  (if (== [pmCues base] cue)
   (if (== field 9)
    (if (>= index [pmGainIndex (+ (* i 2) 1)]) (return -1))
    (return [pmGains (+ [pmGainIndex (* i 2)] index)]))
   (return [pmCues (+ base (+ field 1))]))) (return -1))
(procedure (pmEdge sourceCue targetCue field index)
 ; No Phase B edge is admitted by a Phase A fixture.
 (return -1))
(procedure (pmReaction beat field index) (return -1))
(procedure (pmTake takeId field derivative) (return -1))
(procedure (pmFoley sourceScript event arg0 arg1 field index) (return -1))
(procedure (pmOpening card field)
 (if (or (< card 0) (> card 9) (< field 0) (> field 5)) (return -1))
 (return [pmOpenings (+ (* card 6) field)]))
(procedure (pmHeader field)
 (switch field (0 (return 1)) (1 (return @CUE_COUNT@)) (2 (return 0))
  (3 (return @REACTION_COUNT@)) (4 (return @TAKE_COUNT@)) (5 (return @FOLEY_COUNT@))) (return -1))

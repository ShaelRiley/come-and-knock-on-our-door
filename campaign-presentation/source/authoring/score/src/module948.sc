(procedure (pmReaction beat field index &tmp row base)
 (if (or (< field 0) (> field 7) (< index 0)) (return -1))
 (for ((= row 0)) (< row 9) ((++ row))
  (= base (* row 9))
  (if (== beat [pmReactionRows base])
   (if (== field 6)
    (if (< index [pmReactionRows (+ base 6)]) (return [pmReactionRows (+ base 7)])) (return -1))
   (if (!= index 0) (return -1))
   (return [pmReactionRows (+ base (if (== field 7) 8 else (+ field 1)))])))
 (return -1))

(procedure (pmTake takeId field derivative &tmp row base)
 (if (or (< field 0) (> field 8) (!= derivative 0)) (return -1))
 (if (and (>= takeId 1) (<= takeId 3)) (= row (- takeId 1))
 else (if (and (>= takeId 101) (<= takeId 106)) (= row (- takeId 98)) else (return -1)))
 (= base (* row 10)) (return [pmTakeRows (+ base (+ field 1))]))

(procedure (pmFoley sourceScript event arg0 arg1 field index &tmp row base)
 (if (or (!= sourceScript 0) (< field 0) (> field 5) (< index 0)
  (< arg0 0) (> arg0 1) (!= arg1 0)) (return -1))
 (= row (* arg0 5))
 (if (!= event 0)
  (if (or (< event 11) (> event 14)) (return -1)) (= row (+ row (- event 10))))
 (= base (* row 11))
 (if (== field 4)
  (if (< index [pmFoleyRows (+ base 7)]) (return [pmFoleyRows (+ base (+ 8 index))])) (return -1))
 (if (!= index 0) (return -1))
 (return [pmFoleyRows (+ base (if (== field 5) 10 else (+ field 4)))]))

(procedure (pmOpening card field)
 (if (or (< card 0) (> card 9) (< field 0) (> field 5)) (return -1))
 (return [pmOpenings (+ (* card 6) field)]))
(procedure (pmHeader field)
 (switch field (0 (return 1)) (1 (return 38)) (2 (return 0))
  (3 (return 9)) (4 (return 9)) (5 (return 10))) (return -1))

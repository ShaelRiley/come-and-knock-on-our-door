;;; Sierra Script 1.0 - (do not remove this comment)
; Original stateless E00 projection. No class, globals, locals, sound, or writes.
; Eight performed actions in VIEW245..252, plus title VIEW250/3. TEXT245 stays exact.
; Geometry is supplied by the packed opening asset manifest.
(script# 970)
(public odValid 0 odPhase 1 odCel 2 odView 3 odVisualToken 4 odAudioTick 5 odStaticView 6 odReady 7 odRender 8 odControlEdge 9 odControlAt 10 odPaintControls 11)
(procedure (odValid card tick reduced)
 (if (or (< card 0) (> card 9) (< tick 0) (> tick 359) (< reduced 0) (> reduced 1)) (return 0))
 (return 1))
; phase0=opening title,1=physical action,2=freeze,3=closing title; invalid=-1.
(procedure (odPhase card tick reduced)
 (if (not (odValid card tick reduced)) (return -1))
 (if (== card 0) (return 0))
 (if (== card 9) (return 3))
 (if (or reduced (>= tick 120)) (return 2))
 (return 1))
(procedure (odCel card tick reduced)
 (if (not (odValid card tick reduced)) (return -1))
 (if (or (== card 0) (== card 9)) (return 0))
 (if (or reduced (>= tick 108)) (return 7))
 (if (>= tick 96) (return 6))
 (if (>= tick 84) (return 5))
 (if (>= tick 72) (return 4))
 (if (>= tick (if (== card 1) 54 else 60)) (return 3))
 (if (>= tick (if (== card 1) 36 else 48)) (return 2))
 (if (>= tick (if (== card 1) 18 else 24)) (return 1))
 (return 0))
(procedure (odStaticView card)
 (if (or (< card 0) (> card 9)) (return -1))
 (if (== card 9) (return 104))
 (return (+ 104 card)))
(procedure (odReady card)
 (return (and (>= card 1) (<= card 8))))
(procedure (odView card tick reduced)
 (if (not (odValid card tick reduced)) (return -1))
 (if (and (>= card 1) (<= card 8)) (return (+ 244 card)))
 (return 250))
(procedure (odVisualToken card tick reduced)
 (if (not (odValid card tick reduced)) (return -1))
 (return (+ (* card 32) (* (odPhase card tick reduced) 8) (odCel card tick reduced))))
(procedure (odAudioTick card tick)
 ; Positional request only. Existing music controller owns all audio action.
 (if (or (< card 0) (> card 9) (< tick 0) (> tick 359)) (return -1))
 (return (+ (* card 360) tick)))
(procedure (odRender card tick reduced)
 ; Pure picture projection. Shared title belongs to250/3, not a cast portrait.
 (if (not (odValid card tick reduced)) (return 0))
 (if (or (== card 0) (== card 9))
  (Graph 11 0 0 144 320 1 10 0 0)
  (Graph 11 10 18 12 302 1 4 0 0)
  (DrawCel 250 3 0 16 30 -1 0)
  (Graph 11 116 40 119 280 1 4 0 0)
  (Graph 11 125 80 127 240 1 37 0 0)
  (return 1))
 (if (== card 1)
  (DrawCel 300 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 245 1 0 110 56 -1 0)
   (DrawCel 245 2 0 178 63 -1 0)
   (Graph 11 86 178 88 300 1 4 0 0))
  (DrawCel 245 0 (odCel card tick reduced) 105 56 -1 0)
  (return 1))
 (if (== card 2)
  (DrawCel 101 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 246 1 0 195 25 -1 0)
   (DrawCel 246 2 0 200 62 -1 0))
  (DrawCel 246 0 (odCel card tick reduced) 94 56 -1 0)
  (return 1))
 (if (== card 3)
  (DrawCel 101 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 247 1 0 186 30 -1 0)
   (DrawCel 247 2 0 182 62 -1 0))
  (DrawCel 247 0 (odCel card tick reduced) 96 56 -1 0)
  (return 1))
 (if (== card 4)
  (DrawCel 302 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 248 1 0 188 28 -1 0)
   (DrawCel 248 2 0 188 62 -1 0))
  (DrawCel 248 3 0 83 97 -1 0)
  (DrawCel 248 0 (odCel card tick reduced) 94 52 -1 0)
  (return 1))
 (if (== card 5)
  (DrawCel 304 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 249 1 0 187 31 -1 0)
   (DrawCel 249 2 0 194 62 -1 0))
  (DrawCel 249 0 (odCel card tick reduced) 85 57 -1 0)
  (return 1))
 (if (== card 6)
  (DrawCel 100 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 250 1 0 186 32 -1 0)
   (DrawCel 250 2 0 200 62 -1 0))
  (DrawCel 250 0 (odCel card tick reduced) 98 55 -1 0)
  (return 1))
 (if (== card 7)
  (DrawCel 302 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 251 1 0 185 26 -1 0)
   (DrawCel 251 2 0 188 62 -1 0))
  (DrawCel 251 3 0 82 93 -1 0)
  (DrawCel 251 0 (odCel card tick reduced) 92 55 -1 0)
  (return 1))
 (if (== card 8)
  (DrawCel 303 0 0 0 0 -1 0)
  (if (== (odPhase card tick reduced) 2)
   (Graph 11 0 166 144 320 1 10 0 0)
   (DrawCel 252 1 0 190 25 -1 0)
   (DrawCel 252 2 0 206 62 -1 0))
  (DrawCel 252 0 (odCel card tick reduced) 97 55 -1 0)
  (return 1))
 (return 0))
(procedure (odControlEdge action edge)
 (switch action
  (1 (switch edge (0 (return 5)) (1 (return 146)) (2 (return 103)) (3 (return 163))))
  (2 (switch edge (0 (return 109)) (1 (return 146)) (2 (return 212)) (3 (return 163))))
  (3 (switch edge (0 (return 218)) (1 (return 146)) (2 (return 315)) (3 (return 163))))
  (4 (switch edge (0 (return 5)) (1 (return 168)) (2 (return 103)) (3 (return 185))))
  (5 (switch edge (0 (return 109)) (1 (return 168)) (2 (return 212)) (3 (return 185))))
  (6 (switch edge (0 (return 218)) (1 (return 168)) (2 (return 315)) (3 (return 185)))))
 (return -1))
(procedure (odControlAt px py &tmp action)
 (for ((= action 1)) (<= action 6) ((++ action))
  (if (and (>= px (odControlEdge action 0)) (>= py (odControlEdge action 1))
           (< px (odControlEdge action 2)) (< py (odControlEdge action 3))) (return action)))
 (return 0))
(procedure (odPaintControls card tick held reduced valid unavailable &tmp action left top right bottom [label 80])
 (for ((= action 1)) (<= action 6) ((++ action))
  (= left (odControlEdge action 0)) (= top (odControlEdge action 1))
  (= right (odControlEdge action 2)) (= bottom (odControlEdge action 3))
  (Graph 11 top left bottom right 1 4 0 0)
  (Graph 11 (+ top 1) (+ left 1) (- bottom 1) (- right 1) 1 0 0 0)
  (switch action
   (1 (Format @label "X SKIP")) (2 (Format @label "N NEXT"))
   (3 (Format @label (if held "H RESUME" else "H HOLD")))
   (4 (Format @label "F2 SAVE")) (5 (Format @label "F3 LOAD"))
   (6 (Format @label (if reduced "T STILL" else "T FULL MOTION"))))
  (Display @label 100 (+ left 6) (+ top 5) 102 1 105 0 106 (- (- right left) 12) 121))
 (if valid
  (Format @label (if unavailable "MUSIC UNAVAILABLE" else "Y MUSIC   +/- VOLUME"))
 else (Format @label "INVALID OPENING STATE / F3 LOAD"))
 (Display @label 100 5 190 102 13 105 0 106 310 121) (return 1))

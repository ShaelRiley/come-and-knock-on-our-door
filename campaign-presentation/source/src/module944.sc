   (3 (= currentHi (d p14RevisionHi?)) (= currentLo (d p14RevisionLo?)))
   (4 (= currentHi (d p14RevisionHi?)) (= currentLo (d p14RevisionLo?))))
  (if (or (> hi currentHi) (and (== hi currentHi) (> lo currentLo))) (return 0)))
 (return 1))

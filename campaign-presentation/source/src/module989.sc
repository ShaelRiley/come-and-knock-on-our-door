; Serial pairs are unsigned32 represented as two signed SCI word bit patterns.
(method (p08WordLT a b)
 (if (< a 0) (if (>= b 0) (return 0)) else (if (< b 0) (return 1)))
 (return (not (not (< a b)))))
(method (p08NZ slot) (return (not (not (or [p08Work slot] [p08Work (+ slot 1)])))))
(method (p08EQ a b)
 (return (not (not (and (== [p08Work a] [p08Work b]) (== [p08Work (+ a 1)] [p08Work (+ b 1)]))))))
(method (p08LT a b)
 (if (!= [p08Work a] [p08Work b]) (return (self p08WordLT: [p08Work a] [p08Work b])))
 (return (self p08WordLT: [p08Work (+ a 1)] [p08Work (+ b 1)])))
(method (p08Copy target from)
 (= [p08Work target] [p08Work from]) (= [p08Work (+ target 1)] [p08Work (+ from 1)]) (return 1))
(method (p08Zero slot) (= [p08Work slot] 0) (= [p08Work (+ slot 1)] 0) (return 1))
(method (p08Increment slot)
 (if (and (== [p08Work slot] -1) (== [p08Work (+ slot 1)] -1)) (return 0))
 (= [p08Work (+ slot 1)] (+ [p08Work (+ slot 1)] 1))
 (if (== [p08Work (+ slot 1)] 0) (= [p08Work slot] (+ [p08Work slot] 1))) (return 1))
(method (p08CopyLive &tmp i)
 (for ((= i 0)) (< i STATE_WORDS) ((++ i)) (= [p08Work i] [p08Words i])) (return 1))
(method (p08Clear &tmp i)
 (for ((= i 0)) (< i OUTPUT_WORDS) ((++ i)) (= [p08Output i] 0)) (= p08OutputFault 0) (return 1))
(method (p08Result code)
 (= [p08Output O_CODE] code) (= [p08Output O_REVISION] [p08Work 12]) (= [p08Output (+ O_REVISION 1)] [p08Work 13])
 (= p08CallbackReady 0) (return code))
(method (p08AddRecord record &tmp count index units)
 (if (or (< record 1) (> record 44)) (= p08OutputFault 1) (return 0))
 (= count [p08Output O_RECORD_COUNT]) (= units (self p08UnitCount: record))
 (if (or (>= count p08RecordCapacity) (> (+ [p08Output O_UNIT_COUNT] units) p08UnitCapacity))
  (= p08OutputFault 1) (return 0))
 (= [p08Output (+ O_RECORDS count)] record) (++ [p08Output O_RECORD_COUNT])
 (for ((= index 0)) (< index units) ((++ index))
  (= [p08Output (+ O_UNITS [p08Output O_UNIT_COUNT])] (self p08Unit: record index)) (++ [p08Output O_UNIT_COUNT])) (return 1))
; Event row: kind, commit serial H/L, object/source, choice, request H/L,
; ownership serial H/L, spatial mask, carried service bit, reserved.
(method (p08AddEvent kind object choice tokenH tokenL ownerH ownerL &tmp base)
 (if (>= [p08Output O_EVENT_COUNT] p08EventCapacity) (= p08OutputFault 1) (return 0))
 (= base (+ O_EVENTS (* EVENT_WORDS [p08Output O_EVENT_COUNT]))) (++ [p08Output O_EVENT_COUNT])
 (= [p08Output base] kind) (= [p08Output (+ base 1)] [p08Work 12]) (= [p08Output (+ base 2)] [p08Work 13])
 (= [p08Output (+ base 3)] object) (= [p08Output (+ base 4)] choice)
 (= [p08Output (+ base 5)] tokenH) (= [p08Output (+ base 6)] tokenL)
 (= [p08Output (+ base 7)] ownerH) (= [p08Output (+ base 8)] ownerL)
 (= [p08Output (+ base 9)] (self p08Conditions:))
 (= [p08Output (+ base 10)] (not (not (and (== object OBJ_CERAMIC_CARRIER) [p08Work 6])))) (return 1))
(method (p08Admission records units events)
 (self p08Clear:)
 (if (or p08Busy p08Loading p08Uncertain (< records 0) (> records 3) (< units 0) (> units 6) (< events 0) (> events 2)) (return 0))
 (= p08RecordCapacity records) (= p08UnitCapacity units) (= p08EventCapacity events) (return 1))
(method (p08Begin withContext &tmp code)
 (self p08Clear:)
 (if p08Uncertain (return (self p08Result: CODE_STORAGE_UNCERTAIN)))
 (if p08Busy (return (self p08Result: CODE_BUSY)))
 (if p08Loading (return (self p08Result: CODE_BUSY)))
 (self p08CopyLive:)
 (if (not p08Ready) (return (self p08Result: CODE_SESSION_REQUIRED)))
 (if (not (self p08Validate:)) (return (self p08Result: CODE_INVALID_STATE)))
 (if (and withContext (not p08ContextValid)) (return (self p08Result: CODE_INVALID_CONTEXT))) (return 0))
(method (p08Answer code)
 (if p08OutputFault (self p08Clear:) (return (self p08Result: CODE_OUTPUT_FULL)))
 (return (self p08Result: code)))
; Candidate state and complete bounded output are admitted together. Nothing
; becomes live until a synchronous host publication is ready to commit.
(method (p08Finish code &tmp i)
 (if p08OutputFault (self p08Clear:) (self p08CopyLive:) (return (self p08Result: CODE_OUTPUT_FULL)))
 (if (not (self p08Validate:)) (self p08Clear:) (self p08CopyLive:) (return (self p08Result: CODE_INVALID_STATE)))
 (self p08Result: code)
 (for ((= i 0)) (< i OUTPUT_WORDS) ((++ i)) (= [p08Prepared i] [p08Output i]))
 (self p08Clear:) (= p08Busy 1) (return code))
(method (p08Commit &tmp i)
 (self p08Clear:)
 (if (or (not p08Busy) p08Uncertain p08Loading) (return 0))
 (for ((= i 0)) (< i STATE_WORDS) ((++ i)) (= [p08Words i] [p08Work i]))
 (for ((= i 0)) (< i OUTPUT_WORDS) ((++ i)) (= [p08Output i] [p08Prepared i]) (= [p08Prepared i] 0))
 (= p08Busy 0) (= p08CallbackReady 0) (return 1))
(method (p08Abort &tmp i)
 (self p08Clear:) (if (or (not p08Busy) p08Uncertain) (return 0))
 (for ((= i 0)) (< i OUTPUT_WORDS) ((++ i)) (= [p08Prepared i] 0))
 (= p08Busy 0) (= p08CallbackReady 0) (self p08CopyLive:) (return 1))

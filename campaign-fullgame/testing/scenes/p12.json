      "speaker_id": "audience",
      "speaker_number": 0,
      "voice_index": 46,
      "audio_module": 924
    },
    {
      "text": "SERVE, SHOW, TOAST. I CAN READ THEM FROM HERE. THE\nCHALKBOARD HAS OUR AGREED ORDER TO COMPARE.",

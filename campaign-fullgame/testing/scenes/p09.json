      "record_id": "P09.DIALOGUE.002",
      "resource": 210,
      "entry": 20,
      "header_entry": 0,
      "speaker_id": "stringer",
      "speaker_number": 4,
      "voice_index": 11,
      "audio_module": 921
    },
    {
      "text": "YOU DO ON RENT DAY.",
      "record_id": "P09.DIALOGUE.002",
      "resource": 210,
      "entry": 21,
      "header_entry": 2,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 12,
      "audio_module": 921
    },

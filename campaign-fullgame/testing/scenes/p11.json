    {
      "text": "I YIELD THE ACCOUNT. TELL IT YOUR WAY, WITH THE\nWHOLE TEAM CREDITED.",
      "record_id": "VC03.LOSS",
      "resource": 212,
      "entry": 55,
      "header_entry": 2,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 42,
      "audio_module": 923

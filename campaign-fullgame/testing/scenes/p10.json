      "speaker_number": 2,
      "voice_index": 4,
      "audio_module": 922
    },
    {
      "text": "THOSE WERE MY SEQUENCE REMINDERS.",
      "record_id": "P10.OPEN.001",
      "resource": 211,
      "entry": 6,

      "audio_module": 922
    },
    {
      "text": "FLAT CARD WORKS TOO. THE RACK'S OWN CLIPS HOLD IT.\nFINALLY, I'VE PRINTED SOMETHING TOO THIN TO BE A\nBISCUIT.",
      "record_id": "P10.SUCCESS.004",
      "resource": 211,
      "entry": 26,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 16,
      "audio_module": 922
    },
    {
      "text": "RITA'S TILES. MY FIRST DURABLE MENU.",
      "record_id": "P10.DIALOGUE.001",
      "resource": 211,
      "entry": 27,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 17,
      "audio_module": 922
    },
    {
      "text": "TRY NOT TO TOAST THE CERAMICS.",
      "record_id": "P10.DIALOGUE.001",
      "resource": 211,
      "entry": 29,
      "header_entry": 28,
      "speaker_id": "rita",
      "speaker_number": 7,
      "voice_index": 18,
      "audio_module": 922
    },
    {
      "text": "FROM NOW ON, BREAD IS FOR EATING. I'LL KEEP THE\nSCHEDULE ON THE BOARD.",
      "record_id": "P10.DIALOGUE.002",
      "resource": 211,
      "entry": 30,
      "header_entry": 0,

      "record_id": "P10.LOOK.001",
      "resource": 211,
      "entry": 8,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 7,
      "audio_module": 922
    },
    {
      "text": "THREE WIPE-CLEAN CERAMIC TILES. I CAN WRITE ON\nTHESE WITHOUT ASKING ANYONE TO SPIT THE\nINSTRUCTIONS OUT.",
      "record_id": "P10.LOOK.002",
      "resource": 211,
      "entry": 13,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 8,
      "audio_module": 922
    },
    {
      "text": "THREE BUILT-IN SPRING CLIPS. TILES OR FLAT CARDS\nFIT. NOTHING HAS TO BE TIED TO A GUEST.",
      "record_id": "P10.LOOK.003",
      "resource": 211,
      "entry": 15,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 9,
      "audio_module": 922
    },
    {
      "text": "RITA'S THREE SAMPLE TILES. WIPE-CLEAN, AND MUCH\nHARDER TO BUTTER BY MISTAKE.",
      "record_id": "P10.SUCCESS.001",
      "resource": 211,
      "entry": 16,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 10,
      "audio_module": 922
    },
    {
      "text": "WORD AND MATCHING PICTURE, CLEARLY MARKED. IT RUBS\nOFF IF I GET IT WRONG.",
      "record_id": "P10.SUCCESS.002",
      "resource": 211,
      "entry": 20,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 11,
      "audio_module": 922
    },
    {
      "text": "SERVE, SHOW, TOAST. FEED EVERYONE, LET RITA\nPRESENT, THEN MAKE THE PROMISES. WRITTEN DOWN.\nCLIPPED IN. NOT BAKED.",
      "record_id": "P10.SUCCESS.003",
      "resource": 211,
      "entry": 21,
      "header_entry": 0,
      "speaker_id": "jack",
      "speaker_number": 1,
      "voice_index": 12,
      "audio_module": 922
    },
    {

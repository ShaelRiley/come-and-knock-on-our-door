      "record_id": "P10.FAILURE.001",
      "resource": 211,
      "entry": 22,
      "header_entry": 2,
      "speaker_id": "bunny",
      "speaker_number": 2,
      "voice_index": 13,
      "audio_module": 922
    },
    {

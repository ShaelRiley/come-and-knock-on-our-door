      "text": "YOU BAKED THE PLAN, JACKIE. IT SMELLED FINISHED.",
      "record_id": "P10.OPEN.001",
      "resource": 211,
      "entry": 7,
      "header_entry": 2,
      "speaker_id": "bunny",
      "speaker_number": 2,
      "voice_index": 6,
      "audio_module": 922
    },

(method (h6Label object)
 (switch object
  (73 (return "FOLDING SCREEN FRAME")) (74 (return "UPPER RAIL CLIP MARKS"))
  (75 (return "CLEAN SPARE SHEET")) (76 (return "LARGE LAUNDRY CLIPS"))
  (77 (return "SAMPLE LAYOUT")) (78 (return "ARRIVING VISITOR FIGURE"))
  (79 (return "DISPLAY FIGURE")) (80 (return "MINIATURE SCREEN TOKEN"))
  (81 (return "COMPLETED SCREEN")) (82 (return "ASSEMBLY DRAWING"))
  (83 (return "COURTYARD PLAN")) (84 (return "CLIP MARKS")) (85 (return "VIVIAN VOSS"))) (return "SCREEN"))
(method (h6ShortLabel object)
 ; Five glyphs at the actual6px font fit the32px inventory badge.
 (switch object (75 (return "SHEET")) (76 (return "CLIPS"))) (return "SCRN"))
(method (h6SourceLabel source)
 (switch source (1 (return "Assembly drawing")) (2 (return "Marked pairs of dots"))
  (3 (return "Sample layout and sightlines")) (4 (return "Frankie's sheet permission"))
  (5 (return "Vivian's marked courtyard plan"))) (return "Screen observations"))
(method (h6ApproachX object)
 (switch object (75 (return 280)) (76 (return 103)) (77 (return 54))
  (78 (return 54)) (79 (return 54)) (80 (return 54)) (83 (return 54))
  (81 (return (if (self p06LiveNZ: S_COMPLETE) 111 else 246))) (85 (return 105))) (return 246))
(method (h6ApproachY object) (switch object (75 (return 137)) (76 (return 138)) (85 (return 140))) (return 136))
(method (h6Control object left top right bottom)
 (h6Host uiAddControl: 1 object top left bottom right (self h6Label: object)) (return 1))
(method (h6Controls &tmp complete)
 (if (or (not (h6Host p02PlanAgreed?)) (h6Host onApron?) h6Failure (not h6RestoreValid) (h6Controller hFailure?)) (return 0))
 (= complete (self p06LiveNZ: S_COMPLETE))
 ; uiHit is reverse-order: retained room first, broad roots, then components.
 (switch (h6Host location?)
  (0
   (self h6Control: 85 62 69 92 138)
   (self h6Control: 77 4 97 49 119)
   (self h6Control: 78 13 99 20 113)
   (self h6Control: 79 38 99 47 105)
   (self h6Control: 80 21 99 33 113)
   (if (self p06LiveNZ: S_DEMONSTRATION) (self h6Control: 83 7 114 33 123))
   (if (not complete)
    (self h6Control: (if (== [p06Words S_ASSEMBLY] 3) 81 else 73) 238 54 295 123)
    (if (== [p06Words S_ASSEMBLY] 1) (self h6Control: 75 238 101 295 122))
    (if (== [p06Words S_ASSEMBLY] 2) (self h6Control: 75 242 55 292 100))
    (self h6Control: 74 239 39 294 54)
    (self h6Control: 82 285 77 295 91)))
  (2 (if (not (self p06LiveNZ: S_SHEET_PICKUP)) (self h6Control: 75 291 62 317 79)))
  (3 (if (not (self p06LiveNZ: S_CLIPS_PICKUP)) (self h6Control: 76 78 76 95 89)))
  (4 (if (and complete (== h6ScreenOwner 1))
   (self h6Control: 81 60 69 105 120)
   (self h6Control: 74 60 55 105 69)
   (self h6Control: 82 96 84 107 101))))
 (return 1))
(method (h6CanSpeak)
 (return (if (and h6ArtReady h6Enabled h6RestoreValid (not h6Failure) (not (h6Controller hFailure?)) (h6Host p02PlanAgreed?)
  (== (h6Host location?) h6VivianRoom) (not (h6Host onApron?))
  (not (h6Host opening?)) (== (h6Host motionPhase?) 0)) 1 else 0)))
(method (h6DrawVivian &tmp a mouth)
 (if (or (not h6ArtReady) (not h6Enabled) (not h6RestoreValid) h6Failure (h6Controller hFailure?) (not (h6Host p02PlanAgreed?)) (!= (h6Host location?) h6VivianRoom) (h6Host onApron?)) (return 0))
 (= a (h6Host presentation?)) (= mouth 0)
 (if (and a (== (a lane?) 1) (== (a speaker?) 6)) (= mouth (a mouth?)))
 (if (or (< mouth 0) (> mouth 2)) (= mouth 0))
 (if (and (== (h6Controller hVCEncounter?) 2) (h6Controller hVCStage?) (h6Controller hStagePose: 2)) (= mouth 3))
 (DrawCel 236 1 mouth 54 68 -1 112 112) (return 1))
(method (h6DrawJack &tmp a mouth)
 (if (or (!= (h6Controller hVCEncounter?) 2) (not (h6Controller hVCStage?))
  (h6Host onApron?) (!= (h6Host location?) h6VivianRoom)) (return 0))
 ; Presentation-only stance, no world-location mutation or extra Jackie object.
 (if (h6Controller hStagePose: 1) (DrawCel 330 1 0 145 63 -1 127 127)
 else
  (= a (h6Host presentation?)) (= mouth 0)
  (if (and a (== (a lane?) 1) (== (a speaker?) 1))
   (= mouth (a mouth?)) (if (or (< mouth 0) (> mouth 2)) (= mouth 0))
   (DrawCel 216 1 mouth 145 63 -1 127 127)
  else (DrawCel 214 1 0 145 63 -1 127 127))) (return 1))
(method (h6DrawMiniature &tmp position x y)
 (= position [p06Words S_MINIATURE])
 (DrawCel 231 0 1 89 48 -1 0)
 (DrawCel 231 0 2 99 76 -1 0)
 (DrawCel 231 0 3 197 53 -1 0)
 (DrawCel 231 0 4 197 99 -1 0)
 (= x 59) (= y 4)
 (switch position (1 (= x 73) (= y 18)) (2 (= x 73) (= y 48)) (3 (= x 44) (= y 34)))
 (DrawCel 231 0 5 (+ 89 x) (+ 48 y) -1 0)
 (DrawCel 231 0 (+ 6 (* position 2)) 89 48 -1 0)
 (Display "VISITOR" 100 92 128 102 1 105 0 106 44 121)
 (Display (if (self p06Projection: 3) "DISPLAY: HIDDEN" else "DISPLAY: VISIBLE") 100 155 44 102 1 105 0 106 124 121)
 (Display (if (self p06Projection: 4) "HATCH: CLEAR" else "HATCH: BLOCKED") 100 155 128 102 1 105 0 106 124 121)
 (return 1))
(method (h6Render &tmp assembly complete)
 (if (or (not (h6Host p02PlanAgreed?)) (h6Host onApron?) h6Failure (not h6RestoreValid) (h6Controller hFailure?)) (return 0))
 (= assembly [p06Words S_ASSEMBLY]) (= complete (self p06LiveNZ: S_COMPLETE))
 (switch (h6Host location?)
  (0
   (if (and (== (h6Controller hVCEncounter?) 2) (h6Controller hVCStage?) (h6Controller hStageActive:))
    (DrawCel 331 0 0 0 60 -1 96 96) (DrawCel 331 0 1 22 60 -1 96 96))
   (DrawCel 231 0 0 3 101 -1 0)
   (DrawCel 231 0 (+ 7 (* [p06Words S_MINIATURE] 2)) 12 99 -1 0)
   (if (self p06LiveNZ: S_DEMONSTRATION) (Display "PLAN" 100 7 115 102 1 105 0 106 28 121))
   (if (not complete)
    (if (== assembly 3) (DrawCel 230 0 7 238 39 -1 0)
    else
     (DrawCel 230 0 0 240 39 -1 0)
     (if (== assembly 1) (DrawCel 230 0 2 238 101 -1 0))
     (if (== assembly 2) (DrawCel 230 0 1 239 41 -1 0))
     (DrawCel 230 0 6 240 39 -1 0))
    (DrawCel 232 0 1 286 78 -1 0))
   (self h6DrawVivian:)
   (if (or (== h6PendingSource 3) (and (== (h6Host uiPanel?) 2) (== (h6Host uiChoiceContext?) 222))
     (and (== (h6Host uiPanel?) 4) (or (== (h6Host uiDocument?) 899) (== (h6Host uiDocument?) 914) (== (h6Host uiDocument?) 915) (== (h6Host uiDocument?) 916)))) (self h6DrawMiniature:))
   (if (== h6PendingSource 1) (DrawCel 232 0 0 119 44 -1 0)))
  (2 (if (not (self p06LiveNZ: S_SHEET_PICKUP)) (DrawCel 230 0 4 293 64 -1 0)))
  (3 (if (not (self p06LiveNZ: S_CLIPS_PICKUP)) (DrawCel 230 0 5 80 78 -1 0)))
  (4 (if (and complete (== h6ScreenOwner 1)) (DrawCel 230 0 8 61 56 -1 0) (DrawCel 232 0 1 96 85 -1 0))))
 (return 1))

(method (h7Label object)
 (switch object
  (86 (return "COURTYARD HOTPOT RECIPE")) (87 (return "BEAN-AND-TOMATO BASE"))
  (88 (return "VEGETABLE BOWL")) (89 (return "STOCK BOTTLE")) (90 (return "MEASURING JUG"))
  (91 (return "HERB SACHET")) (92 (return "HOTPOT POT")) (93 (return "POT LID")) (94 (return "STOVE"))) (return "BUNNY"))
(method (h7ShortLabel object)
 (switch object (86 (return "RECIPE")) (87 (return "BASE")) (88 (return "VEG")) (89 (return "STOCK"))
  (90 (return "JUG")) (91 (return "HERBS")) (92 (return "POT")) (93 (return "LID")) (94 (return "STOVE"))) (return "BUNNY"))
(method (h7ApproachX object)

  (90 (return 197)) (91 (return 175)) (92 (return 113)) (93 (return 87)) (94 (return 113))) (return 198))
(method (h7ApproachY object)
 (switch object (86 (return 126)) (87 (return 129)) (88 (return 129)) (89 (return 127))
  (90 (return 129)) (91 (return 129)) (92 (return 128)) (93 (return 129)) (94 (return 128))) (return 139))
(method (h7Control object left top right bottom)
 (h7Host uiAddControl: 1 object top left bottom right (self h7Label: object)) (return 1))

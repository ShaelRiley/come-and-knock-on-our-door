(method (h7PotCel &tmp contents)
 (if (self p07Projection: 8) (return -1))
 (if (self p07Projection: 3) (return 9))
 (= contents (self p07Projection: 7))
 (if (& contents 8) (return 8))
 (if (self h7LiveNZ: S_COOKED) (return (if (self h7LiveNZ: S_HEAT_OFF) 7 else 6)))
 (switch contents (7 (return 5)) (5 (return 4)) (3 (return 3)) (1 (return 2)) (2 (return 1))) (return 0))
(method (h7Render &tmp pot)
 (if (or (not h7Enabled) (not h7RestoreValid) h7Failure (not (h7Host p02PlanAgreed?))
  (h7Host onApron?) (!= (h7Host location?) 2)) (return 0))
 (DrawCel 233 0 0 68 67 -1 0)
 (DrawCel 233 0 1 95 69 -1 0) (DrawCel 233 0 2 120 69 -1 0)
 (DrawCel 233 0 3 49 60 -1 0) (DrawCel 233 0 4 147 64 -1 0)
 (DrawCel 233 0 (if (== (self p07Object: 5 1) 7) 6 else 5) 166 65 -1 0)
 (DrawCel 233 0 8 159 44 -1 0)
 (= pot (self h7PotCel:))
 (if (>= pot 0)
  (DrawCel 234 0 pot 63 65 -1 0)
  (if (not (self p07Projection: 3)) (DrawCel 233 0 7 46 78 -1 0)))
 (if (self p07Projection: 2) (DrawCel 233 0 9 67 79 -1 0) (DrawCel 234 0 10 66 59 -1 0)) (return 1))
(method (h7DrawBunny &tmp a mouth)
 (if (or (not h7RestoreValid) h7Failure (not h7BunnyInvited) (!= (h7Controller hBunnyRoom?) 2)
  (!= (h7Host location?) 2) (h7Host onApron?)) (return 0))
 (= a (h7Host presentation?)) (= mouth 0)
 (if (and a (== (a lane?) 1) (== (a speaker?) 2)) (= mouth (a mouth?)))
 (if (or (< mouth 0) (> mouth 2)) (= mouth 0))
 ; One instance owned by985, original219 mouth cels, facing the actual player.
 (DrawCel 219 (if (> (h7Host motionX?) 14720) 0 else 1) mouth 204 61 -1 127 127) (return 1))

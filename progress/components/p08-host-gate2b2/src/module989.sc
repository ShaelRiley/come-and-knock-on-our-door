 (= p08CallbackReady 0) (return code))
(method (p08AddRecord record &tmp count index units)
 (if (or (< record 1) (> record 44)) (= p08OutputFault 1) (return 0))
 (= count [p08Output O_RECORD_COUNT]) (= units (self p08UnitCount: record))
 (if (or (>= count p08RecordCapacity) (> (+ [p08Output O_UNIT_COUNT] units) p08UnitCapacity))
  (= p08OutputFault 1) (return 0))
 (= [p08Output (+ O_RECORDS count)] record) (++ [p08Output O_RECORD_COUNT])
 (for ((= index 0)) (< index units) ((++ index))
  (= [p08Output (+ O_UNITS [p08Output O_UNIT_COUNT])] (self p08Unit: record index)) (++ [p08Output O_UNIT_COUNT])) (return 1))
; Event row: kind, commit serial H/L, object/source, choice, request H/L,
; ownership serial H/L, spatial mask, carried service bit, reserved.
(method (p08AddEvent kind object choice tokenH tokenL ownerH ownerL &tmp base)
 (if (>= [p08Output O_EVENT_COUNT] p08EventCapacity) (= p08OutputFault 1) (return 0))
 (= base (+ O_EVENTS (* EVENT_WORDS [p08Output O_EVENT_COUNT]))) (++ [p08Output O_EVENT_COUNT])
 (= [p08Output base] kind) (= [p08Output (+ base 1)] [p08Work 12]) (= [p08Output (+ base 2)] [p08Work 13])
 (= [p08Output (+ base 3)] object) (= [p08Output (+ base 4)] choice)
 (= [p08Output (+ base 5)] tokenH) (= [p08Output (+ base 6)] tokenL)
 (= [p08Output (+ base 7)] ownerH) (= [p08Output (+ base 8)] ownerL)
 (= [p08Output (+ base 9)] (self p08Conditions:))
 (= [p08Output (+ base 10)] (not (not (and (== object OBJ_CERAMIC_CARRIER) [p08Work 6])))) (return 1))

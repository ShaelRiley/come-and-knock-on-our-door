     [p08Session 4] [p08Session 5] [p08Session 6] [p08Session 7] [p08Words S_REVISION] [p08Words (+ S_REVISION 1)])) (return (self h8Uncertain:)))
   (if (or (!= (self p08AcknowledgeHandoff: key hi lo) CODE_HANDOFF_ACKNOWLEDGED) (not p08Busy)) (return (self h8Uncertain:)))

(method (h8ProjectContext &tmp f v wins claims p r t i j obj cloth)
 (if (or (not (self h8PublishersReady:)) (not (self h8OwnersValid:))) (return 0))
 (= f (self h8Preparations:)) (if (< f 0) (return 0))
 (= p (h8Host p03?)) (= r (h8Host p05?)) (= t (h8Host p06?))
 (= v (r hContestFlags:)) (= wins 0) (= claims 0)
 (if (& v 16) (= wins (| wins 1))) (if (& v 32) (= wins (| wins 2)))
 (if [p08Words S_LAYOUT_READY] (= claims 1)) (if [p08Words S_EVENING_STARTED] (= claims (| claims 2)))
 (if (not (self h8InventoryRawValid:)) (return 0))
 (return (self p08SetContext: (self h8ToDomain: (h8Host location?)) (h8Host onApron?) f wins claims (p p03Padding?)
   (self h8ToDomain: (t h6FrankieRoom?)) (self h8ToDomain: (r hBunnyRoom?)) (self h8ContestBusy:) 0 0 0)))

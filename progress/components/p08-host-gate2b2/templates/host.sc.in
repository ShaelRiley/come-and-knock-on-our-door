  (or [p08Words owner] [p08Words (+ owner 1)])
  (== [h8OwnerReceipts slot] [p08Words owner])
  (== [h8OwnerReceipts (+ slot 1)] [p08Words (+ owner 1)])
  (self h8SerialBefore: [p08Words owner] [p08Words (+ owner 1)] [p08Words (+ owner 10)] [p08Words (+ owner 11)])
  (not (self h8SerialBefore: [p08Words S_REVISION] [p08Words (+ S_REVISION 1)] [p08Words (+ owner 10)] [p08Words (+ owner 11)]))) 1 else 0)))
(method (h8OwnersValid &tmp i slot owner present p)
 (if (or (not h8Host) (< h8PaddingPlace 0) (> h8PaddingPlace 2)) (return 0))
 (= p (h8Host p03?)) (if (or (not p) (not (p p03Validate:))) (return 0))
 (for ((= i 0)) (< i 5) ((++ i))
  (= slot (* i 2)) (= owner (+ S_OWNER_CERAMIC_CARRIER slot))
  (= present (or [p08Words owner] [p08Words (+ owner 1)]))
  (if present
   (if (not (self h8Owns: (self h8OwnerKey: i))) (return 0))
   else
   (if (or (!= [h8OwnerCodes i] (self h8PriorOwner: i)) [h8OwnerReceipts slot] [h8OwnerReceipts (+ slot 1)]
    [p08Words (+ owner 10)] [p08Words (+ owner 11)]) (return 0))))

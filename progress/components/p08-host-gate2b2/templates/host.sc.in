; Validate raw current inventory before restore publishers can reconstruct it.
; Empty reserved slots remain legal; every published item must have its real owner.
(method (h8InventoryRawValid &tmp i j obj cloth)
 (if (or (< (h8Host uiInventoryExtent?) 0) (> (h8Host uiInventoryExtent?) 64)) (return 0))
 (= cloth (self h8OriginalCloth:))
 (for ((= i 0)) (< i 64) ((++ i))
  (= obj (h8Host p04UIItem: i))
  (if (or (< obj 0) (and (>= i (h8Host uiInventoryExtent?)) obj)
    (== obj 34) (== obj 36) (== obj 40) (== obj 63) (== obj 81)) (return 0))
  (if (and obj (not (h8Host campaignHeld: obj))) (return 0))
  (if obj (for ((= j 0)) (< j i) ((++ j)) (if (== obj (h8Host p04UIItem: j)) (return 0))))
  ; Exclude only the exact ACKed original now owned by the checked host continuation.
  ; Every physical roster must already agree. Unclaimed padding remains a conflict.
  (if (and cloth (== obj cloth) (not (and (self h8ClothHeld: cloth) (self h8ClothRawValid:)))) (return 0)))
 (return 1))

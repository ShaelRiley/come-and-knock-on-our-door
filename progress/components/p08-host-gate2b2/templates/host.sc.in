  (= p (h8Host p03?)) (if (or (not p) (not (p p03Validate:)) (!= (p p03Ready?) 1)) (return 0)))
 (= index (self h8OwnerIndex: key)) (if (< index 0) (return 0))
 (= slot (* index 2)) (= owner (+ S_OWNER_CERAMIC_CARRIER slot))

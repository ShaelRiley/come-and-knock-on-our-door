  (= high [p08Work S_REVISION]) (= low [p08Work (+ S_REVISION 1)])
  (for ((= i 0)) (< i h8TransferCount) ((++ i))
   (if (== low -1) (if (== high -1) (return 0)) (++ high) (= low 0) else (++ low))))
 (= h8ReservedCount count) (= h8Prepared 1) (return 1))
(method (h8Uncertain)
 (= h8Failure 20) (= h8Enabled 0) (= h8RestoreValid 0)
 (if p08Busy (self p08StorageUncertain:)) (return 0))
(method (h8CommitReserved &tmp i key hi lo r t)
 (if (or (not h8Critical) (!= h8Prepared 1)) (return 0))

  (if (not (self h8ScreenOwnerValid:)) (return 0))
  else (if (or (!= ((h8Host p06?) h6ScreenOwner?) 1) (!= ((h8Host p06?) h6ScreenPosition?) 0)) (return 0)))
 (if [p08Words S_RETURNED_PADDING]
  (if (or (not (self h8Owns: 22)) (not (self h8OriginalCloth:))
    (!= [p08Words S_RETURNED_PADDING] (p p03Padding?)) (== h8PaddingPlace 0)) (return 0))
  else (if (or h8PaddingPlace (self h8Owns: 22)) (return 0)))

  (== (r hPAOwner?) 2) (== (r hPARoom?) 4) (== (r hCartOwner?) 1) (== (r hCartRoom?) 5)
  (>= [p08Words S_PA_POSITION] 1) (<= [p08Words S_PA_POSITION] 4)) 1 else 0)))
(method (h8ScreenOwnerValid &tmp t)

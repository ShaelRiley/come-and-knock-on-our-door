(method (h8ReservePages document &tmp d first count row r)
 (= d (h8Host dialogue?)) (= r (h8Host p05?))
 (= first (d sdRoute: document)) (= count (d sdPageCount: document))
 (if (or (< first 1070) (>= first 1138) (< count 1) (> count 64) (> (+ first count) 1138)) (return 0))
 (for ((= row first)) (< row (+ first count)) ((++ row))
  (if (or (not (r hStaticRange: 3 (* row 8) 8))
   (not (r hStaticRange: 5 row 1)) (not (r hStaticRange: 6 row 1))
   (not (r hStaticRange: 7 row 1))) (return 0))) (return 1))
(method (h8Reserve &tmp i j key index slot owner ack count units record document high low unitIndex)
 (= h8Prepared 0) (= h8TransferCount 0)
 (if (or (not h8Critical) (not (self h8OwnersValid:))) (return 0))
 (= count (self h8Output: O_RECORD_COUNT)) (= units (self h8Output: O_UNIT_COUNT)) (= unitIndex 0)
 (if (or (< count 0) (> count 3) (< units 0) (> units 6)
  (< (self h8Output: O_EVENT_COUNT) 0) (> (self h8Output: O_EVENT_COUNT) 2)
  (< (h8Host bridgeQueueCount?) 0) (> (h8Host bridgeQueueCount?) 32) (> (+ (h8Host bridgeQueueCount?) count) 32)) (return 0))
 (for ((= i 0)) (< i 39) ((++ i)) (= [h8ReservedOutput i] (self h8Output: i)))
 (for ((= i 0)) (< i 3) ((++ i)) (= [h8ReservedDocuments i] 0))
 (for ((= i 0)) (< i count) ((++ i))
  (= record [h8ReservedOutput (+ O_RECORDS i)]) (= document (+ 972 record))
  (if (or (< record 1) (> record 44)
   (!= ((h8Host dialogue?) sdPageCount: document) (self h8ExpectedPages: record))
   (!= ((h8Host dialogue?) sdRoute: document) (self h8ExpectedStart: record))
   (not (self h8ReservePages: document))) (return 0))
  (for ((= j 0)) (< j (self h8ExpectedUnitCount: record)) ((++ j))
   (if (or (>= unitIndex units) (!= [h8ReservedOutput (+ O_UNITS unitIndex)] (self h8ExpectedUnit: record j))) (return 0))
   (++ unitIndex))
  (= [h8ReservedDocuments i] document))
 (if (!= unitIndex units) (return 0))
 (for ((= i 0)) (< i 10) ((++ i)) (= [h8ReservedReceipts i] [h8OwnerReceipts i]) (= [h8TransferSerials i] 0))
 (for ((= i 0)) (< i 5) ((++ i)) (= [h8ReservedOwners i] [h8OwnerCodes i]) (= [h8TransferKeys i] 0))
 (if p08Busy
  (if (or (< [p08Work S_OWNER_ORDER_COUNT] 0) (> [p08Work S_OWNER_ORDER_COUNT] 5)) (return 0))
  (for ((= i 0)) (< i [p08Work S_OWNER_ORDER_COUNT]) ((++ i))
   (= key [p08Work (+ S_OWNER_ORDER_0 i)])
   (for ((= j 0)) (< j i) ((++ j)) (if (== [p08Work (+ S_OWNER_ORDER_0 j)] key) (return 0)))
   (= index (self h8OwnerIndex: key))
   (if (< index 0) (return 0)) (= slot (* index 2)) (= owner (+ S_OWNER_CERAMIC_CARRIER slot)) (= ack (+ owner 10))
   (if (not (or [p08Work ack] [p08Work (+ ack 1)]))
    (if (or (>= h8TransferCount 5) (!= [h8OwnerCodes index] (self h8PriorOwner: index))
     [h8OwnerReceipts slot] [h8OwnerReceipts (+ slot 1)]) (return 0))
    (= [h8TransferKeys h8TransferCount] key)
    (= [h8TransferSerials (* h8TransferCount 2)] [p08Work owner])
    (= [h8TransferSerials (+ (* h8TransferCount 2) 1)] [p08Work (+ owner 1)])
    (= [h8ReservedReceipts slot] [p08Work owner]) (= [h8ReservedReceipts (+ slot 1)] [p08Work (+ owner 1)])

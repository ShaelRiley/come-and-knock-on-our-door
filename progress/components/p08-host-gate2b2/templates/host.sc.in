; Unsigned32 high/low comparison; ACK stores its later revision, not transfer serial.
(method (h8WordBefore a b)
 (if (!= (< a 0) (< b 0)) (return (if (< b 0) 1 else 0))) (return (< a b)))
(method (h8SerialBefore ah al bh bl)
 (return (if (== ah bh) (self h8WordBefore: al bl) else (self h8WordBefore: ah bh))))

; All13facts are projected from existing campaign history; wins are independent.
(method (h8Preparations &tmp p q r t u v f flags)
 (if (not h8Host) (return -1))
 (= p (h8Host p03?)) (= q (h8Host p04?)) (= r (h8Host p05?)) (= t (h8Host p06?)) (= u (h8Host p07?))
 (if (or (not p) (not q) (not r) (not t) (not u)) (return -1))
 (if (or (not (p p03Validate:)) (not (q p04Validate:))
  (not (r hSaveReady:)) (not (t h6SaveReady:)) (not (u h7SaveReady:))) (return -1))
 (= f 0) (= v (r hContestFlags:))
 (if (h8Host p02PlanAgreed?) (= f (| f 1)))
 (if (p p03Ready?) (= f (| f 2)))
 (if (q p04Ready:) (= f (| f 12)))
 (= flags (r p05Flags:))
 (if (& flags 1) (= f (| f 16))) (if (& flags 2) (= f (| f 32))) (if (& flags 4) (= f (| f 128)))
 (if (& v 1) (= f (| f 64))) (if (& v 2) (= f (| f 1024)))
 (= flags (t p06Projection: 0))
 (if (& flags 2) (= f (| f 256))) (if (& flags 1) (= f (| f 512))) (if (& flags 4) (= f (| f 2048)))
 (if (& (u p07Projection: 0) 2) (= f (| f 4096))) (return f))

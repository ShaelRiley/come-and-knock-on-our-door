(method (p08BeginAction object target preparation &tmp code)
 (= code (self p08Begin: 1)) (if code (return code))
 (= code (self p08Blocked: object target preparation)) (if code (return (self p08Result: code))) (return 0))
(method (p08Look object &tmp code record)
 (= code (self p08BeginAction: object 0 0)) (if code (return code))
 (if (and (== object OBJ_PLAN_OVERLAY) @layout_ready)
  (self p08AddRecord: R_P08_LOOK_007) (self p08AddRecord: R_P08_SYSTEM_003) (return (self p08Answer: CODE_LAYOUT_READY)))
 (if (and (== object OBJ_CREDIT_SLATE) (!= @credit_position 1)) (return (self p08Answer: CODE_INSPECT_STATE)))
 (if (self p08LookBinding: object) (return (self p08Answer: CODE_OBSERVED)))
 (return (self p08Answer: CODE_INSPECT_STATE)))
(method (p08AcknowledgeSource object record &tmp code slot)
 (= code (self p08Begin: 1)) (if code (return code))
 (= slot (self p08SourceSlot: object))
 (if (or (not slot) (!= record (self p08SourceRecord: object))) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (= code (self p08Blocked: object 0 0)) (if code (return (self p08Result: code)))
 (if (not (self p08MatchCallback:)) (return (self p08Result: CODE_STALE_SESSION)))
 (if (and (== object OBJ_CREDIT_SLATE) (!= @credit_position 1)) (return (self p08Result: CODE_CREDIT_NOT_DISPLAYED)))
 (if (self p08NZ: slot) (return (self p08Result: CODE_SOURCE_ALREADY_OBSERVED)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (self p08Copy: slot S_REVISION)
 (self p08AddEvent: EVENT_SOURCE_OBSERVED object record 0 0 0 0)
 (return (self p08Finish: CODE_SOURCE_OBSERVED)))
(method (p08Introduce &tmp code)
 (= code (self p08BeginAction: OBJ_FRANKIE OBJ_BUNNY 1)) (if code (return code))
 (if (or (self p08NZ: S_ONCE_INTRO) @evening_started) (return (self p08Result: CODE_LAYOUT_STATE)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (self p08Copy: S_ONCE_INTRO S_REVISION) (self p08AddRecord: R_P08_SCENE_001)
 (self p08AddEvent: EVENT_INTRO 0 0 0 0 0 0) (return (self p08Finish: CODE_INTRODUCED)))
(method (p08Place object position pull &tmp code slot owner first record)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (or (< object 1) (> object 5) (< position 1) (> position 4) (< pull 0) (> pull 1)) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (= code (self p08Blocked: object 0 1)) (if code (return (self p08Result: code)))
 (if (& p08Protected (self p08ProtectedBit: object)) (return (self p08Result: CODE_OCCUPIED_OBJECT)))
 (= slot (self p08PositionSlot: object))
 (if (== [p08Work slot] position) (return (self p08Result: CODE_ALREADY_POSITIONED)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (= [p08Work slot] position) (= owner (self p08OwnerSlot: object))
 (= first (not (not (and (!= object OBJ_SERVING_TABLE) (not (self p08NZ: owner))))))
 (if first
  (self p08Copy: owner S_REVISION)
  (if (not (self p08AppendOwner: object)) (self p08CopyLive:) (return (self p08Result: CODE_INVALID_STATE)))) (self p08Copy: (self p08PlacementSlot: object) S_REVISION)
 (self p08SyncLayout:) (= record R_P08_LOOK_007)
 (if (== position 4) (= record R_P08_FAILURE_001)
 else
  (if (== object OBJ_COMPLETED_SCREEN)
   (if (== position 3) (= record R_P08_SUCCESS_004)
   else (if (== position 1) (= record R_P08_FAILURE_002) else (= record R_P08_FAILURE_004)))
  else
   (if (== object OBJ_PA_KIT)
    (if (== @facing 2) (= record R_P08_FAILURE_003)
    else (if (== position 2) (= record R_P08_SUCCESS_003)))
   else
    (if (== position 1)
     (switch object
      (OBJ_CERAMIC_CARRIER (= record R_P08_SUCCESS_001))
      (OBJ_CREDIT_SLATE (= record R_P08_SUCCESS_007))
      (OBJ_SERVING_TABLE (if pull (= record R_P08_SUCCESS_006) else (= record R_P08_SUCCESS_005))))))))
 (self p08AddRecord: record) (if @layout_ready (self p08AddRecord: R_P08_SYSTEM_003))
 (if first (self p08AddEvent: EVENT_OWNERSHIP_HANDOFF object 0 0 0 @revision.H @revision.L))
 (self p08AddEvent: EVENT_PLACE object position 0 0 0 0) (return (self p08Finish: CODE_POSITIONED)))
(method (p08Orient facing &tmp code record)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (or (< facing 1) (> facing 2)) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (= code (self p08Blocked: OBJ_PA_KIT 0 1)) (if code (return (self p08Result: code)))
 (if (& p08Protected 2) (return (self p08Result: CODE_OCCUPIED_OBJECT)))
 (if (== facing @facing) (return (self p08Result: CODE_ALREADY_ORIENTED)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (= @facing facing) (self p08Copy: S_PLACE_PA_FACING S_REVISION) (self p08SyncLayout:)
 (if (== facing 2) (self p08AddRecord: R_P08_FAILURE_003)
 else (if (== @pa_position 2) (self p08AddRecord: R_P08_SUCCESS_003)))
 (self p08AddEvent: EVENT_ORIENT OBJ_PA_KIT facing 0 0 0 0) (return (self p08Finish: CODE_ORIENTED)))
(method (p08Unpack &tmp code cloth)
 (= code (self p08BeginAction: OBJ_CERAMIC_CARRIER 0 1)) (if code (return code))
 (if @service_unpacked (return (self p08Result: CODE_ALREADY_UNPACKED)))
 (if (or (!= @carrier_position 1) (!= @table_position 1)) (return (self p08Result: CODE_BUFFET_SURFACE_REQUIRED)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (= @service_unpacked 1) (= @returned_padding p08Padding)
 (self p08Copy: S_SURFACE_CERAMIC_CARRIER S_PLACE_CERAMIC_CARRIER) (self p08Copy: S_SURFACE_SERVING_TABLE S_PLACE_SERVING_TABLE)
 (self p08Copy: S_OWNER_PADDING S_REVISION)
 (if (not (self p08AppendOwner: 22)) (self p08CopyLive:) (return (self p08Result: CODE_INVALID_STATE)))
 (self p08Copy: S_ONCE_UNPACK S_REVISION) (self p08SyncLayout:)
 (= cloth OBJ_CLEAN_TOWEL) (if (== p08Padding 2) (= cloth OBJ_CLEAN_NAPKIN))
 (self p08AddRecord: R_P08_SUCCESS_002)
 (if (== p08Padding 1) (self p08AddRecord: R_P08_SYSTEM_001) else (self p08AddRecord: R_P08_SYSTEM_002))
 (self p08AddEvent: EVENT_OWNERSHIP_HANDOFF cloth 0 0 0 @revision.H @revision.L)
 (self p08AddEvent: EVENT_UNPACK cloth 0 0 0 0 0) (return (self p08Finish: CODE_SERVICE_UNPACKED)))
(method (p08AcknowledgeHandoff object hi lo &tmp code owner ack)
 (= code (self p08Begin: 0)) (if code (return code))
 (if (not (self p08MatchCallback:)) (return (self p08Result: CODE_STALE_SESSION)))
 (= owner (self p08OwnerSlot: object)) (= ack (self p08AckSlot: object))
 (if (or (not owner) (not (self p08NZ: owner)) (self p08NZ: ack)
  (!= hi [p08Work owner]) (!= lo [p08Work (+ owner 1)])) (return (self p08Result: CODE_STALE_HANDOFF)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (self p08Copy: ack S_REVISION) (self p08AddEvent: EVENT_OWNERSHIP_ACK object 0 0 0 hi lo)
 (return (self p08Finish: CODE_HANDOFF_ACKNOWLEDGED)))
(method (p08LayoutDialogue &tmp code)
 (= code (self p08BeginAction: OBJ_FRANKIE OBJ_BUNNY 1)) (if code (return code))
 (if (not @layout_ready) (return (self p08Result: CODE_LAYOUT_INCOMPLETE)))
 (self p08AddRecord: R_P08_DIALOGUE_001) (return (self p08Answer: CODE_LAYOUT_DIALOGUE)))
(method (p08Hint level &tmp code)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (or (< level 0) (> level 3)) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (if (!= p08Preparations ALL_PREPARATIONS) (return (self p08Result: CODE_PREPARATIONS_REQUIRED)))
 (if (== level 0) (= level (+ @hint_level 1)) (if (> level 3) (= level 3)))
 (switch level
  (1 (self p08AddRecord: R_P08_HINT_1)) (2 (self p08AddRecord: R_P08_HINT_2)) (3 (self p08AddRecord: R_P08_HINT_3)))
 (if (<= level @hint_level) (return (self p08Answer: CODE_HINT)))
 (if (not (self p08Increment: S_REVISION)) (self p08Clear:) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (= @hint_level level) (self p08AddEvent: EVENT_HINT 0 level 0 0 0 0) (return (self p08Finish: CODE_HINT)))
; Nine ordinary verbs in original order. All spatial destinations are choices;
; no hatch navigation, pocket furniture, later win, or implied consent exists.
(method (p08Act verb object target &tmp code position)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (or (< verb 1) (> verb 9)) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (if (and (== verb 5) (== target 0)) (return (self p08Look: object)))
 (= code (self p08Blocked: object target 1)) (if code (return (self p08Result: code)))
 (= position 0)
 (switch target (OBJ_BUFFET_POSITION (= position 1)) (OBJ_SPEAKER_POSITION (= position 2))
  (OBJ_DISPLAY_ALCOVE (= position 3)) (OBJ_GATE_LANE (= position 4)))
 (if (and (>= object 1) (<= object 5) position
  (or (== verb 7) (and (== object OBJ_SERVING_TABLE) (or (== verb 8) (== verb 9)))))
  (return (self p08Place: object position (not (not (== verb 9))))))
 (if (and (== object OBJ_CERAMIC_CARRIER) (== target 0) (or (== verb 2) (== verb 7))) (return (self p08Unpack:)))
 (if (and (== object OBJ_FRANKIE) (== verb 6) (== target 0)) (return (self p08RequestStart:)))
 (return (self p08Result: CODE_UNHELPFUL)))

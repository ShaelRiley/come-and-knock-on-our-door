; Branch-local room/object enums are not native room/object allocations.
(method (p08SetContext room apron preparations wins claimedFlags padding frankie bunny contest protected inventoryConflict paddingPocket)
 (self p08Clear:) (= p08ContextValid 0) (= p08CallbackReady 0)
 (if (or p08Busy p08Loading p08Uncertain (< room 1) (> room 7) (< frankie 1) (> frankie 7) (< bunny 1) (> bunny 7)
  (< apron 0) (> apron 1) (< contest 0) (> contest 1) (< preparations 0) (> preparations 8191)
  (< wins 0) (> wins 3) (< claimedFlags 0) (> claimedFlags 3) (< padding 0) (> padding 2)
  (< protected 0) (> protected 31) (!= inventoryConflict 0) (!= paddingPocket 0)) (return 0))
 (if (and (& preparations PREP_CERAMICS_READY) (== padding 0)) (return 0))
 (if (and (& preparations PREP_SOUND_READY) (!= (& preparations 112) 112)) (return 0))
 (if (and (& preparations PREP_SCREEN_READY) (!= (& preparations 1792) 1792)) (return 0))
 (if (and (& preparations PREP_HOLD_OPEN_AVAILABLE) (not (& preparations PREP_GATE_TESTED))) (return 0))
 (if (and (& wins 1) (not (& preparations PREP_VC01_RESOLVED))) (return 0))
 (if (and (& wins 2) (not (& preparations PREP_VC02_RESOLVED))) (return 0))
 (= p08Room room) (= p08Apron apron) (= p08Preparations preparations) (= p08Wins wins) (= p08ClaimedFlags claimedFlags)
 (= p08Padding padding) (= p08FrankieRoom frankie) (= p08BunnyRoom bunny) (= p08Contest contest) (= p08Protected protected)
 (= p08InventoryObject 0) (= p08InventoryTarget 0) (= p08ContextValid 1) (return 1))
(method (p08Inventory objectContains targetContains)
 (if (or p08Busy p08Loading p08Uncertain (< objectContains 0) (> objectContains 1) (< targetContains 0) (> targetContains 1)) (return 0))
 (= p08InventoryObject objectContains) (= p08InventoryTarget targetContains) (return 1))
(method (p08Location object &tmp slot)
 (if (== object OBJ_FRANKIE) (return p08FrankieRoom))
 (if (== object OBJ_BUNNY) (return p08BunnyRoom))
 (if (== object OBJ_CIRCULATION_PLAN) (if (& p08Preparations PREP_GATE_TESTED) (return 5)) (return 0))
 (if (== object OBJ_SIGHTLINE_PLAN) (if (& p08Preparations PREP_SCREEN_READY) (return 5)) (return 0))
 (if (== object OBJ_HOTPOT_POT) (if (& p08Preparations PREP_FOOD_READY) (return 2)) (return 0))
 (if (or (== object OBJ_LINEN_HOOK) (and (== object OBJ_CLEAN_TOWEL) (== @returned_padding 1))
  (and (== object OBJ_CLEAN_NAPKIN) (== @returned_padding 2))) (return 2))
 (if (or (== object OBJ_CERAMIC_CARRIER) (== object OBJ_CREDIT_SLATE) (== object OBJ_CERAMIC_SERVICE))
  (if (not (& p08Preparations PREP_CERAMICS_READY)) (return 0))
  (= slot S_CARRIER_POSITION) (if (== object OBJ_CREDIT_SLATE) (= slot S_CREDIT_POSITION))
  (if [p08Work slot] (return 5)) (return 8))
 (if (== object OBJ_PA_KIT) (if (& p08Preparations PREP_SOUND_READY) (return 5)) (return 0))
 (if (== object OBJ_COMPLETED_SCREEN) (if (& p08Preparations PREP_SCREEN_READY) (return 5)) (return 0))
 (if (and (>= object 1) (<= object OBJ_BUNNY)) (return 5)) (return 0))
(method (p08Reachable object inInventory &tmp location)
 (= location (self p08Location: object))
 (return (not (not (and (not p08Apron) (or inInventory (== location p08Room)
  (and (== location 8) (or (== p08Room 2) (== p08Room 5)))))))))
(method (p08Blocked object target preparation)
 (if (and preparation (!= p08Preparations ALL_PREPARATIONS)) (return CODE_PREPARATIONS_REQUIRED))
 (if (and preparation p08Contest) (return CODE_CONTEST_ACTIVE))
 (if (or p08Apron (not (self p08Reachable: object p08InventoryObject))
  (and target (!= target -2) (not (self p08Reachable: target p08InventoryTarget)))) (return CODE_OFFSCREEN))
 (if (and preparation (!= p08Room 5)) (return CODE_COURTYARD_REQUIRED))
 (if (and @returned_padding (!= @returned_padding p08Padding)) (return CODE_INVALID_CONTEXT)) (return 0))
(method (p08Conditions &tmp result i)
 (= result 0)
 (if (and @service_unpacked (== @carrier_position 1) (== @table_position 1) (== @credit_position 1)) (= result (+ result 1)))
 (if (and (== @pa_position 2) (== @facing 1)) (= result (+ result 2)))
 (if (== @screen_position 3) (= result (+ result 4)))
 (if (!= @screen_position 1) (= result (+ result 8)))
 (for ((= i S_CARRIER_POSITION)) (<= i S_CREDIT_POSITION) ((++ i)) (if (== [p08Work i] 4) (return result)))
 (return (+ result 16)))
(method (p08ClearRequest)
 (= @pending_phase 0) (self p08Zero: S_PENDING_REQUEST_SERIAL) (self p08Zero: S_PENDING_REQUESTED_AT)
 (self p08Zero: S_CHECKLIST_RECEIPT) (self p08Zero: S_CONFIRMED_AT) (return 1))
(method (p08SyncLayout)
 (= @layout_ready (not (not (== (self p08Conditions:) 31)))) (self p08ClearRequest:) (return 1))
(method (p08PendingHandoffs &tmp i count)
 (= count 0)
 (for ((= i S_OWNER_CERAMIC_CARRIER)) (<= i S_OWNER_PADDING) ((= i (+ i 2)))
  (if (and (self p08NZ: i) (not (self p08NZ: (+ i (- S_ACK_CERAMIC_CARRIER S_OWNER_CERAMIC_CARRIER))))) (++ count))) (return count))
(method (p08ValidateContext &tmp progress i)
 (if (not p08ContextValid) (return 0))
 (= progress (not (not (or @hint_level (self p08NZ: S_REQUEST_SERIAL)))))
 (for ((= i S_PLACE_CERAMIC_CARRIER)) (<= i S_ONCE_EVENING) ((= i (+ i 2))) (if (self p08NZ: i) (= progress 1)))
 (if (and progress (!= p08Preparations ALL_PREPARATIONS)) (return 0))
 (if (and @returned_padding (!= @returned_padding p08Padding)) (return 0))
 (if (and (& p08ClaimedFlags 1) (not @layout_ready)) (return 0))
 (if (and (& p08ClaimedFlags 2) (not @evening_started)) (return 0)) (return 1))
(method (p08ValidateCurrent withContext &tmp code)
 (= code (self p08Begin: withContext)) (if code (return code))
 (if (and withContext (not (self p08ValidateContext:))) (return (self p08Result: CODE_INVALID_CONTEXT))) (return 0))
; Read queries below copy committed state. They never make observations/receipts.
(method (p08Query query object inventory &tmp code)
 (= code (self p08Begin: 1)) (if code (return 0))
 (switch query
  (1 (return (self p08Location: object)))
  (2 (return (self p08Reachable: object inventory)))
  (3 (return (self p08Conditions:)))
  (4 (return (self p08PendingHandoffs:)))
 ) (return 0))

; R2: append only a first physical claim. No ACK or later move reorders keys.
(method (p08AppendOwner key &tmp i)
 (if (or (< @owner_order_count 0) (>= @owner_order_count 5) (not (self p08OwnerSlot: key))) (return 0))
 (for ((= i 0)) (< i @owner_order_count) ((++ i))
  (if (== [p08Work (+ S_OWNER_ORDER_0 i)] key) (return 0)))
 (= [p08Work (+ S_OWNER_ORDER_0 @owner_order_count)] key) (++ @owner_order_count) (return 1))
; The returned pending queue follows the saved owner-key sequence, filtering
; ACKed claims. Read only committed words, even while a candidate is staged.
(method (p08PendingKey index &tmp i key ack pending)
 (if (or (< index 0) (>= index 5)) (return 0)) (= pending 0)
 (for ((= i 0)) (and (< i 5) (< i [p08Words S_OWNER_ORDER_COUNT])) ((++ i))
  (= key [p08Words (+ S_OWNER_ORDER_0 i)]) (= ack (self p08AckSlot: key))
  (if (and ack (not (or [p08Words ack] [p08Words (+ ack 1)])))
   (if (== pending index) (return key)) (++ pending))) (return 0))

; The literal reference's consistency invariants, expressed over fixed words.
(method (p08Validate &tmp i j slot owner ack expected hasPending)
 (for ((= i S_CARRIER_POSITION)) (<= i S_CREDIT_POSITION) ((++ i))
  (if (or (< [p08Work i] 0) (> [p08Work i] 4)) (return 0)))
 (if (or (< @facing 1) (> @facing 2) (< @service_unpacked 0) (> @service_unpacked 1)
  (< @returned_padding 0) (> @returned_padding 2) (< @layout_ready 0) (> @layout_ready 1)
  (< @evening_started 0) (> @evening_started 1) (< @hint_level 0) (> @hint_level 3)
  (< @pending_phase 0) (> @pending_phase 3)) (return 0))
 ; R2 stores the whole owner-ledger key order, including already ACKed keys.
 ; It is a bounded permutation of exactly the nonzero owner claims, not time order.
 (if (or (< @owner_order_count 0) (> @owner_order_count 5)) (return 0))
 (= expected 0)
 (for ((= i S_OWNER_CERAMIC_CARRIER)) (<= i S_OWNER_PADDING) ((= i (+ i 2)))
  (if (self p08NZ: i) (++ expected)))
 (if (!= expected @owner_order_count) (return 0))
 (for ((= i 0)) (< i 5) ((++ i))
  (= slot [p08Work (+ S_OWNER_ORDER_0 i)])
  (if (>= i @owner_order_count)
   (if (!= slot 0) (return 0))
  else
   (= owner (self p08OwnerSlot: slot))
   (if (or (not owner) (not (self p08NZ: owner))) (return 0))
   (for ((= j 0)) (< j i) ((++ j))
    (if (== slot [p08Work (+ S_OWNER_ORDER_0 j)]) (return 0)))))
 ; Every nonzero receipt is bounded by committed candidate revision.
 (for ((= i S_REQUEST_SERIAL)) (<= i S_SURFACE_SERVING_TABLE) ((= i (+ i 2)))
  (if (self p08LT: S_REVISION i) (return 0)))
 (for ((= i 1)) (<= i 5) ((++ i))
  (= slot (self p08PositionSlot: i)) (= expected (not (not [p08Work slot])))
  (if (!= expected (self p08NZ: (self p08PlacementSlot: i))) (return 0))
  (if (!= i OBJ_SERVING_TABLE)
   (= owner (self p08OwnerSlot: i)) (= ack (self p08AckSlot: i))
   (if (!= expected (self p08NZ: owner)) (return 0))
   (if (and (self p08NZ: ack) (or (not expected) (not (self p08LT: owner ack)))) (return 0))
   (if (and expected (self p08LT: (self p08PlacementSlot: i) owner)) (return 0))))
 (if (and (== @facing 2) (not (self p08NZ: S_PLACE_PA_FACING))) (return 0))
 (if (or (!= @service_unpacked (not (not @returned_padding)))
  (!= @service_unpacked (self p08NZ: S_ONCE_UNPACK))
  (!= @service_unpacked (self p08NZ: S_OWNER_PADDING))
  (!= @service_unpacked (self p08NZ: S_SURFACE_CERAMIC_CARRIER))
  (!= @service_unpacked (self p08NZ: S_SURFACE_SERVING_TABLE))) (return 0))
 (if (and (self p08NZ: S_ACK_PADDING)
  (or (not @service_unpacked) (not (self p08LT: S_OWNER_PADDING S_ACK_PADDING)))) (return 0))
 (if @service_unpacked
  (if (or (not @carrier_position) (not @table_position)
   (not (self p08LT: S_SURFACE_CERAMIC_CARRIER S_ONCE_UNPACK))
   (not (self p08LT: S_SURFACE_SERVING_TABLE S_ONCE_UNPACK))
   (self p08LT: S_PLACE_CERAMIC_CARRIER S_SURFACE_CERAMIC_CARRIER)
   (self p08LT: S_PLACE_SERVING_TABLE S_SURFACE_SERVING_TABLE)
   (not (self p08EQ: S_OWNER_PADDING S_ONCE_UNPACK))) (return 0)))
 (if (!= @layout_ready (not (not (== (self p08Conditions:) 31)))) (return 0))
 (if (!= @evening_started (self p08NZ: S_ONCE_EVENING)) (return 0))
 (if (and @evening_started (not @service_unpacked)) (return 0))
 (if (and (or @pending_phase @evening_started) (self p08PendingHandoffs:)) (return 0))
 (if (self p08LT: S_REQUEST_SERIAL S_PENDING_REQUEST_SERIAL) (return 0))
 (= hasPending (not (not @pending_phase)))
 (if (or (!= hasPending (self p08NZ: S_PENDING_REQUEST_SERIAL))
  (!= hasPending (self p08NZ: S_PENDING_REQUESTED_AT))
  (and hasPending (or (not @layout_ready) @evening_started))
  (!= (self p08NZ: S_CHECKLIST_RECEIPT) (not (not (>= @pending_phase 2))))
  (!= (self p08NZ: S_CONFIRMED_AT) (not (not (== @pending_phase 3))))) (return 0))
 (if (and (self p08NZ: S_CHECKLIST_RECEIPT) (not (self p08LT: S_PENDING_REQUESTED_AT S_CHECKLIST_RECEIPT))) (return 0))
 (if (and (self p08NZ: S_CONFIRMED_AT) (not (self p08LT: S_CHECKLIST_RECEIPT S_CONFIRMED_AT))) (return 0))
 (if hasPending
  (if (not (self p08LT: S_ONCE_UNPACK S_PENDING_REQUESTED_AT)) (return 0))
  (for ((= i S_PLACE_CERAMIC_CARRIER)) (<= i S_PLACE_PA_FACING) ((= i (+ i 2)))
   (if (not (self p08LT: i S_PENDING_REQUESTED_AT)) (return 0)))
  (for ((= i S_ACK_CERAMIC_CARRIER)) (<= i S_ACK_PADDING) ((= i (+ i 2)))
   (if (not (self p08LT: i S_PENDING_REQUESTED_AT)) (return 0))))
 ; Independent source actions cannot share a receipt with another source,
 ; one-shot, or placement action. Original ledger ordering is preserved.
 (for ((= i S_SOURCE_CIRCULATION_PLAN)) (<= i S_SOURCE_CREDIT_SLATE) ((= i (+ i 2)))
  (if (self p08NZ: i)
   (for ((= j (+ i 2))) (<= j S_ONCE_EVENING) ((= j (+ j 2)))
    (if (self p08EQ: i j) (return 0)))))
 (for ((= i S_ONCE_INTRO)) (<= i S_ONCE_EVENING) ((= i (+ i 2)))
  (if (self p08NZ: i)
   (for ((= j (+ i 2))) (<= j S_ONCE_EVENING) ((= j (+ j 2)))
    (if (self p08EQ: i j) (return 0)))))
 (for ((= i S_COMPLETED_REQUEST_SERIAL)) (<= i S_COMPLETED_CONFIRMATION_RECEIPT) ((= i (+ i 2)))
  (if (!= @evening_started (self p08NZ: i)) (return 0)))
 (if @evening_started
  (if (or (not (self p08NZ: S_REQUEST_SERIAL))
   (self p08LT: S_REQUEST_SERIAL S_COMPLETED_REQUEST_SERIAL)
   (not (self p08LT: S_COMPLETED_REQUESTED_AT S_COMPLETED_CHECKLIST_RECEIPT))
   (not (self p08LT: S_COMPLETED_CHECKLIST_RECEIPT S_COMPLETED_CONFIRMATION_RECEIPT))
   (not (self p08LT: S_COMPLETED_CONFIRMATION_RECEIPT S_ONCE_EVENING))
   (not (self p08LT: S_ONCE_UNPACK S_ONCE_EVENING))) (return 0))
  (for ((= i S_ACK_CERAMIC_CARRIER)) (<= i S_ACK_PADDING) ((= i (+ i 2)))
   (if (not (self p08LT: i S_COMPLETED_REQUESTED_AT)) (return 0))))
 (return 1))
; Quiet streaming ordinary save/load of this branch. Whole-campaign atomicity
; and native RestoreGame callback retirement remain the host's responsibility.
(method (p08SaveWord index)
 (if (or p08Busy p08Loading p08Uncertain (< index 0) (>= index ENVELOPE_WORDS)) (return 0))
 (if (< index 20) (return (self p08Header: index))) (return [p08Words (- index 20)]))
(method (p08LoadBegin)
 (self p08Clear:) (= p08CallbackReady 0)
 (if (or p08Busy p08Loading p08Uncertain) (return 0)) (= p08Loading 1) (= p08LoadIndex 0) (return 1))
(method (p08LoadWord index value)
 (self p08Clear:)
 (if (or (not p08Loading) (!= index p08LoadIndex) (< index 0) (>= index ENVELOPE_WORDS))
  (= p08Loading 0) (= p08LoadIndex 0) (return 0))
 (if (< index 20)
  (if (!= value (self p08Header: index)) (= p08Loading 0) (= p08LoadIndex 0) (return 0))
 else (= [p08Load (- index 20)] value)) (++ p08LoadIndex) (return 1))
(method (p08LoadFinish withContext &tmp i)
 (self p08Clear:)
 (if (or (not p08Loading) (!= p08LoadIndex ENVELOPE_WORDS) p08Busy p08Uncertain)
  (= p08Loading 0) (= p08LoadIndex 0) (return (self p08Result: CODE_INVALID_STATE)))
 (= p08Loading 0) (= p08LoadIndex 0)
 (for ((= i 0)) (< i STATE_WORDS) ((++ i)) (= [p08Work i] [p08Load i]))
 (if (not (self p08Validate:)) (self p08CopyLive:) (return (self p08Result: CODE_INVALID_STATE)))
 (if (and withContext (not (self p08ValidateContext:))) (self p08CopyLive:) (return (self p08Result: CODE_INVALID_CONTEXT)))
 (for ((= i 0)) (< i STATE_WORDS) ((++ i)) (= [p08Words i] [p08Work i]))
 (self p08AfterRestore:) (return (self p08Result: CODE_RESTORED)))

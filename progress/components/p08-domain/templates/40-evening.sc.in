(method (p08PendingPresentation &tmp code)
 (= code (self p08BeginAction: OBJ_FRANKIE 0 1)) (if code (return code))
 (if (== @pending_phase 1)
  (self p08AddRecord: R_P08_CHOICE_001) (self p08AddRecord: R_P08_DIALOGUE_002) (self p08AddRecord: R_P08_SYSTEM_004)
  (return (self p08Answer: CODE_READINESS_REQUESTED)))
 (if (== @pending_phase 2)
  (self p08AddRecord: R_P08_CHOICE_002) (self p08AddRecord: R_P08_CHOICE_003)
  (return (self p08Answer: CODE_CONFIRMATION_PENDING)))
 (if (== @pending_phase 3) (return (self p08Result: CODE_AUTOSAVE_PENDING)))
 (return (self p08Result: CODE_NO_PENDING_START)))
(method (p08RequestStart &tmp code)
 (= code (self p08BeginAction: OBJ_FRANKIE 0 1)) (if code (return code))
 (if @evening_started (return (self p08Result: CODE_EVENING_STARTED)))
 (if (not @layout_ready) (return (self p08Result: CODE_LAYOUT_INCOMPLETE)))
 (if (self p08PendingHandoffs:) (return (self p08Result: CODE_HANDOFF_PENDING)))
 (if @pending_phase (return (self p08PendingPresentation:)))
 (if (or (and (== @revision.H -1) (== @revision.L -1))
  (and (== @request_serial.H -1) (== @request_serial.L -1))) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (self p08Increment: S_REVISION) (self p08Increment: S_REQUEST_SERIAL)
 (self p08Copy: S_PENDING_REQUEST_SERIAL S_REQUEST_SERIAL) (self p08Copy: S_PENDING_REQUESTED_AT S_REVISION) (= @pending_phase 1)
 (self p08AddRecord: R_P08_CHOICE_001) (self p08AddRecord: R_P08_DIALOGUE_002) (self p08AddRecord: R_P08_SYSTEM_004)
 (self p08AddEvent: EVENT_READINESS 0 0 @pending_request_serial.H @pending_request_serial.L 0 0)
 (return (self p08Finish: CODE_READINESS_REQUESTED)))
(method (p08MatchRequest hi lo phase)
 (return (not (not (and (== hi @pending_request_serial.H) (== lo @pending_request_serial.L) (== phase @pending_phase))))))
(method (p08AcknowledgeReadiness hi lo record1 record2 &tmp code)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (or (!= record1 R_P08_DIALOGUE_002) (!= record2 R_P08_SYSTEM_004)) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (= code (self p08Blocked: OBJ_FRANKIE 0 1)) (if code (return (self p08Result: code)))
 (if (not (self p08MatchCallback:)) (return (self p08Result: CODE_STALE_SESSION)))
 (if (not (self p08MatchRequest: hi lo 1)) (return (self p08Result: CODE_STALE_READINESS)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (= @pending_phase 2) (self p08Copy: S_CHECKLIST_RECEIPT S_REVISION)
 (self p08AddRecord: R_P08_CHOICE_002) (self p08AddRecord: R_P08_CHOICE_003)
 (self p08AddEvent: EVENT_CHECKLIST 0 0 hi lo 0 0) (return (self p08Finish: CODE_CONFIRMATION_PENDING)))
(method (p08ConfirmStart hi lo accepted &tmp code)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (or (< accepted 0) (> accepted 1)) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (= code (self p08Blocked: OBJ_FRANKIE 0 1)) (if code (return (self p08Result: code)))
 (if (not (self p08MatchCallback:)) (return (self p08Result: CODE_STALE_SESSION)))
 (if (not (self p08MatchRequest: hi lo 2)) (return (self p08Result: CODE_STALE_CONFIRMATION)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (if (not accepted)
  (self p08ClearRequest:) (self p08AddRecord: R_P08_SYSTEM_005) (self p08AddEvent: EVENT_DECLINED 0 0 hi lo 0 0)
  (return (self p08Finish: CODE_DECLINED)))
 (= @pending_phase 3) (self p08Copy: S_CONFIRMED_AT S_REVISION)
 (self p08AddEvent: EVENT_AUTOSAVE 0 0 hi lo 0 0) (return (self p08Finish: CODE_AUTOSAVE_REQUESTED)))
(method (p08RetryAutosave hi lo &tmp code)
 (= code (self p08BeginAction: OBJ_FRANKIE 0 1)) (if code (return code))
 (if (not (self p08MatchCallback:)) (return (self p08Result: CODE_STALE_SESSION)))
 (if (not (self p08MatchRequest: hi lo 3)) (return (self p08Result: CODE_STALE_AUTOSAVE)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (self p08AddEvent: EVENT_AUTOSAVE 0 0 hi lo 0 0) (return (self p08Finish: CODE_AUTOSAVE_REQUESTED)))
; The caller alone verifies actual save I/O. A menu, caption, audio completion,
; or save-request event cannot enter E03. False ACK preserves confirmed request.
(method (p08AcknowledgeAutosave hi lo succeeded &tmp code)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (or (< succeeded 0) (> succeeded 1)) (return (self p08Result: CODE_INVALID_ARGUMENT)))
 (= code (self p08Blocked: OBJ_FRANKIE 0 1)) (if code (return (self p08Result: code)))
 (if (not (self p08MatchCallback:)) (return (self p08Result: CODE_STALE_SESSION)))
 (if (not (self p08MatchRequest: hi lo 3)) (return (self p08Result: CODE_STALE_AUTOSAVE)))
 (if (not succeeded) (return (self p08Result: CODE_AUTOSAVE_FAILED)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (= @evening_started 1) (self p08Copy: S_ONCE_EVENING S_REVISION)
 (self p08Copy: S_COMPLETED_REQUEST_SERIAL S_PENDING_REQUEST_SERIAL)
 (self p08Copy: S_COMPLETED_REQUESTED_AT S_PENDING_REQUESTED_AT)
 (self p08Copy: S_COMPLETED_CHECKLIST_RECEIPT S_CHECKLIST_RECEIPT)
 (self p08Copy: S_COMPLETED_CONFIRMATION_RECEIPT S_CONFIRMED_AT)
 (self p08ClearRequest:) (self p08AddRecord: R_P08_SYSTEM_006)
 (self p08AddEvent: EVENT_EVENING 0 0 hi lo 0 0) (return (self p08Finish: CODE_EVENING_STARTED)))
(method (p08CancelStart &tmp code hi lo)
 (= code (self p08Begin: 1)) (if code (return code))
 (if (not @pending_phase) (return (self p08Result: CODE_NO_PENDING_START)))
 (if (not (self p08Increment: S_REVISION)) (return (self p08Result: CODE_SERIAL_EXHAUSTED)))
 (= hi @pending_request_serial.H) (= lo @pending_request_serial.L) (self p08ClearRequest:)
 (self p08AddEvent: EVENT_CANCELLED 0 0 hi lo 0 0) (return (self p08Finish: CODE_START_CANCELLED)))

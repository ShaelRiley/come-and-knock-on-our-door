; Hand-authored port of the unchanged accepted P04 component.
(method (p04Clear &tmp i)
    (= p04Code 0) (= p04LineCount 0) (= p04EventCount 0)
    (= p04ResultHi 0) (= p04ResultLo 0)
    (for ((= i 0)) (< i 8) ((++ i)) (= [p04Lines i] 0))
    (= [p04Events 0] 0) (= [p04EventArgs 0] 0) (= [p04EventArgs2 0] 0)
    (return 1))
(method (p04Init)
    (if p04Initialized (return 0))
    (= p04Initialized 1) (self p04Clear:) (return 1))
(method (p04Context room apron plan wedgeHeld &tmp i)
    (self p04Clear:) (= p04ContextValid 0)
    (if (or (< room 0) (> room 6) (< apron 0) (> apron 1)
        (< plan 0) (> plan 1) (< wedgeHeld 0) (> wedgeHeld 1)
        (and wedgeHeld p04Wedge))
        (= p04Code CODE_INVALID_CONTEXT) (return 0))
    (= p04Room room) (= p04Apron apron) (= p04Plan plan)
    (for ((= i 0)) (<= i P04_OBJECT_LIMIT) ((++ i)) (= [p04Held i] 0))
    (= [p04Held OBJ_WEDGE] wedgeHeld) (= p04ContextValid 1) (return 1))
(method (p04AppendLine line)
    (if (or (< line 1) (> line 36) (>= p04LineCount 8)) (return 0))
    (= [p04Lines p04LineCount] line) (++ p04LineCount) (return 1))
(method (p04Line index)
    (if (or (< index 0) (>= index p04LineCount)) (return 0)) (return [p04Lines index]))
(method (p04Event index)
    (if (or (< index 0) (>= index p04EventCount)) (return 0)) (return [p04Events index]))
(method (p04EventArg index)
    (if (or (< index 0) (>= index p04EventCount)) (return 0)) (return [p04EventArgs index]))
(method (p04EventArg2 index)
    (if (or (< index 0) (>= index p04EventCount)) (return 0)) (return [p04EventArgs2 index]))
(method (p04Status code binding)
    (= p04Code code) (if binding (self p04Bind: binding)) (return code))
; Public predicates promise 0/1; SCI value-position and/or return raw operands.
(method (p04Ready) (return (not (not (or p04CompleteHi p04CompleteLo)))))
(method (p04Know) (return (not (not (and p04LatchSource p04HookSource)))))
(method (p04Start needsContext)
    (self p04Clear:)
    (if (not (self p04Validate:)) (= p04Code CODE_INVALID_STATE) (return 0))
    (if (and needsContext (or (not p04ContextValid) (and p04Wedge [p04Held OBJ_WEDGE])))
        (= p04Code CODE_INVALID_CONTEXT) (return 0))
    (return 1))
(method (p04CanCommit)
    (if (and (== p04RevisionHi 32767) (== p04RevisionLo 32767))
        (= p04Code CODE_SERIAL_EXHAUSTED) (return 0)) (return 1))
(method (p04Commit code binding event arg arg2)
    ; All callers check capacity BEFORE changing persistent state.
    (if (== p04RevisionLo 32767) (= p04RevisionLo 0) (++ p04RevisionHi)
        else (++ p04RevisionLo))
    (= p04ResultHi p04RevisionHi) (= p04ResultLo p04RevisionLo)
    (= p04Code code) (if binding (self p04Bind: binding))
    (= [p04Events 0] event) (= [p04EventArgs 0] arg) (= [p04EventArgs2 0] arg2)
    (= p04EventCount 1)
    (if (== event EVENT_P04_INTRO) (= p04IntroHi p04RevisionHi) (= p04IntroLo p04RevisionLo))
    (if (== event EVENT_P04_COMPLETE) (= p04CompleteHi p04RevisionHi) (= p04CompleteLo p04RevisionLo))
    (return code))
(method (p04Location obj)
    ; room0..6, inventory10, gate11, latch12, fixed-hook13, absent/external -1.
    (switch obj
        (OBJ_WEDGE (return (if p04Wedge 11 else -1)))
        (OBJ_WELCOME_BUNTING (return (if (== p04Bunting 0) 12 else (if (== p04Bunting 1) 10 else 13))))
        (OBJ_CIRCULATION_PLAN (return (if (self p04Ready:) 1 else -1)))
        (OBJ_CIRCULATION_BOARD (return (if (self p04Ready:) 1 else -1)))
        (OBJ_SIDE_GATE (return 3)) (OBJ_ALIGNED_HINGES (return 3))
        (OBJ_LATCH_ARM (return 3)) (OBJ_FIXED_HOOK (return 3))
        (OBJ_HOLD_OPEN_PEG (return 3)) (OBJ_FELIX (return 3)))
    (return -1))
(method (p04Reachable obj &tmp loc)
    (if (or (not p04ContextValid) p04Apron (and p04Wedge [p04Held OBJ_WEDGE])) (return 0))
    (= loc (self p04Location: obj))
    (if (== loc -1)
        (if (or (< obj 1) (> obj P04_OBJECT_LIMIT)) (return 0))
        (return [p04Held obj]))
    (if (or (== loc 10) (== loc p04Room)) (return 1))
    (if (and (>= loc 11) (<= loc 13)) (return (== p04Room 3)))
    (return 0))
(method (p04Guard obj target preparation)
    (if p04Apron (= p04Code CODE_OFFSCREEN) (return 0))
    (if (and preparation (not p04Plan)) (= p04Code CODE_PLAN_REQUIRED) (return 0))
    (if (or (not (self p04Reachable: obj)) (and target (not (self p04Reachable: target))))
        (= p04Code CODE_OFFSCREEN) (return 0))
    (return 1))
(method (p04Observe latch hook)
    (if (not (or (and latch (not p04LatchSource)) (and hook (not p04HookSource)))) (return 0))
    (if (not (self p04CanCommit:)) (return -1))
    (if (and latch (not p04LatchSource)) (= p04LatchSource latch))
    (if (and hook (not p04HookSource)) (= p04HookSource hook))
    (return 1))
(method (p04Look obj &tmp binding latch hook changed)
    (if (not (self p04Start: 1)) (return p04Code))
    (if (not (self p04Guard: obj 0 0)) (return p04Code))
    (= binding 0) (= latch 0) (= hook 0)
    (if (== p04Bunting 0)
        (switch obj
            (OBJ_SIDE_GATE (= binding BIND_GATE_ORIGINAL) (= latch LINE_P04_LOOK_001))
            (OBJ_LATCH_ARM (= binding BIND_LATCH_ORIGINAL) (= latch LINE_P04_LOOK_003))
            (OBJ_WELCOME_BUNTING (= binding BIND_BUNTING_ORIGINAL) (= latch LINE_P04_LOOK_004)))
        else (if (and (== obj OBJ_SIDE_GATE) (self p04Ready:) (== p04Bunting 2))
            (= binding BIND_GATE_CHECKED)))
    (switch obj
        (OBJ_FIXED_HOOK (= binding BIND_HOOK) (= hook LINE_P04_LOOK_005))
        (OBJ_ALIGNED_HINGES (= binding BIND_HINGES))
        (OBJ_HOLD_OPEN_PEG (= binding (if (self p04Ready:) BIND_PEG_AVAILABLE else BIND_PEG_UNAVAILABLE)))
        (OBJ_WEDGE (= binding BIND_WEDGE))
        (OBJ_CIRCULATION_PLAN (= binding BIND_PLAN)) (OBJ_CIRCULATION_BOARD (= binding BIND_PLAN)))
    (= changed (self p04Observe: latch hook))
    (if (< changed 0) (return p04Code))
    (if changed (return (self p04Commit: CODE_OBSERVED binding EVENT_P04_OBSERVE 0 0)))
    (return (self p04Status: (if binding CODE_OBSERVED else CODE_INSPECT_STATE) binding)))
(method (p04Topic actor topic &tmp changed intro)
    (if (not (self p04Start: 1)) (return p04Code))
    (if (or (< topic 1) (> topic 3)) (return (self p04Status: CODE_INVALID_ARGUMENT 0)))
    (if (not (self p04Guard: actor 0 1)) (return p04Code))
    (if (!= actor OBJ_FELIX) (return (self p04Status: CODE_UNHELPFUL 0)))
    (if (self p04Ready:) (return (self p04Status: CODE_GATE_CHECKED BIND_PEG_AVAILABLE)))
    (if (!= p04Bunting 0)
        (return (self p04Status: (if (== p04Bunting 1) CODE_HOOK_REQUIRED else CODE_TEST_REQUIRED) 0)))
    (= intro (and (< topic 3) (not (or p04IntroHi p04IntroLo)) (not p04Wedge)))
    (if (and intro (not (self p04CanCommit:))) (return p04Code))
    (= changed (self p04Observe: LINE_P04_DIALOGUE_001 LINE_P04_DIALOGUE_001))
    (if (< changed 0) (return p04Code))
    (if intro
        (= p04Gate 0)
        (self p04Commit: CODE_INTRODUCED BIND_INTRO EVENT_P04_INTRO 0 0)
        (self p04Bind: BIND_INSTRUCTIONS) (return p04Code))
    (if changed (return (self p04Commit: CODE_INSTRUCTIONS BIND_INSTRUCTIONS EVENT_P04_OBSERVE 0 0)))
    (return (self p04Status: CODE_INSTRUCTIONS BIND_INSTRUCTIONS)))
(method (p04OpenGate)
    (if (not (self p04Start: 1)) (return p04Code))
    (if (not (self p04Guard: OBJ_SIDE_GATE 0 1)) (return p04Code))
    (if (== p04Gate 1) (return (self p04Status: CODE_ALREADY_OPEN 0)))
    (if (not (self p04CanCommit:)) (return p04Code))
    (= p04Gate 1)
    (return (self p04Commit: CODE_GATE_OPEN (if (== p04Bunting 0) BIND_OPENED_ORIGINAL else 0) EVENT_P04_GATE_OPEN 0 0)))
(method (p04PlaceWedge)
    (if (not (self p04Start: 1)) (return p04Code))
    (if (not (self p04Guard: OBJ_SIDE_GATE 0 1)) (return p04Code))
    (if p04Wedge (return (self p04Status: CODE_ALREADY_WEDGED 0)))
    (if (not [p04Held OBJ_WEDGE]) (return (self p04Status: CODE_WEDGE_REQUIRED 0)))
    (if (!= p04Gate 1) (return (self p04Status: CODE_OPEN_REQUIRED 0)))
    (if p04Peg (return (self p04Status: CODE_ALREADY_HELD_BY_PEG 0)))
    (if (not (self p04CanCommit:)) (return p04Code))
    (= p04Wedge 1)
    (return (self p04Commit: CODE_GATE_WEDGED BIND_WEDGED EVENT_P04_WEDGE_PLACED OBJ_WEDGE 0)))
(method (p04RecoverWedge)
    (if (not (self p04Start: 1)) (return p04Code))
    (if (not (self p04Guard: OBJ_SIDE_GATE 0 1)) (return p04Code))
    (if (not p04Wedge)
        (return (self p04Status: (if [p04Held OBJ_WEDGE] CODE_ALREADY_HELD else CODE_WEDGE_ELSEWHERE) 0)))
    (if (not (self p04CanCommit:)) (return p04Code))
    (= p04Wedge 0)
    (return (self p04Commit: CODE_WEDGE_RECOVERED BIND_WEDGE_RECOVERED EVENT_P04_WEDGE_RECOVERED OBJ_WEDGE 0)))
(method (p04MoveBunting destination &tmp previous binding changed)
    ; Numeric bunting position is also the stable destination parameter.
    (if (not (self p04Start: 1)) (return p04Code))
    (if (or (< destination 0) (> destination 2)) (return (self p04Status: CODE_INVALID_ARGUMENT 0)))

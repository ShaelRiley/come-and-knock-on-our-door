; P04 reservation uses the complete staged P03 roster, retaining wedge reservations.
(method (q8Item index) (if (or (< index 0) (>= index 64)) (return 0)) (return [q8Slots index]))
(method (q8CurrentItem index) (if (or (< index 0) (>= index 64)) (return 0)) (return [qSlots index]))
(method (q8Held h obj change)
 (if (== obj (if (< change 0) (- 0 change) else change)) (return (> change 0)))
 (return (self qHeld: h obj)))
(method (q8Append obj &tmp i slot)
 (if (not obj) (return 1)) (if (or (< obj 1) (> obj 62) (and (> obj 50) (!= obj OBJ_WELCOME_BUNTING))) (return 0))
 (for ((= i 0)) (< i q8Extent) ((++ i)) (if (== [q8Slots i] obj) (return 1)))
 (= slot [q8Reservations obj])
 (if (and (>= slot 0) (< slot q8Extent) (== [q8Slots slot] 0)) (= [q8Slots slot] obj)
  else (if (>= q8Extent 64) (return 0)) (= [q8Slots q8Extent] obj) (++ q8Extent))
 (= [q8Reservations obj] -1) (return 1))
(method (q8Prepare h p change &tmp i j obj compact)
 (= q8Prepared 0)
 (if (or qFailure (not (self q8Valid:)) (not qInventoryStarted) (not (p b8Prepared?)) (< (p b8Extent?) 0) (> (p b8Extent?) 64) (not (h p02PlanAgreed?))) (return 0))
 (= q8Extent qExtent) (= compact (!= qLastRoom (h location?)))
 (for ((= i 0)) (< i 64) ((++ i)) (= [q8Slots i] [qSlots i]))
 (for ((= i 0)) (< i 63) ((++ i)) (= [q8Reservations i] [qReserve i]))
 (for ((= i 0)) (< i q8Extent) ((++ i))
  (= obj [q8Slots i])
  (if (and obj (not (self q8Held: h obj change))) (= [q8Reservations obj] i) (= [q8Slots i] 0)))
 (for ((= i 0)) (< i (p b8Extent?)) ((++ i))
  (= obj (p b8Item: i))
  (if (and obj (self q8Held: h obj change)) (if (not (self q8Append: obj)) (return 0))))
 (if (not (self q8Append: (self p04InventoryAt: 0))) (return 0))
 (if compact
  (= j 0) (for ((= i 0)) (< i q8Extent) ((++ i)) (if [q8Slots i] (= [q8Slots j] [q8Slots i]) (++ j)))
  (for ((= i j)) (< i 64) ((++ i)) (= [q8Slots i] 0)) (= q8Extent j)
  (for ((= i 0)) (< i 63) ((++ i)) (= [q8Reservations i] -1)))
 (if (not (self q8StageValid:)) (return 0))
 (= q8Prepared 1) (return 1))
(method (q8Matches &tmp i)
 (if (or (not q8Prepared) (!= q8Extent qExtent)) (return 0))
 (for ((= i 0)) (< i 64) ((++ i)) (if (!= [q8Slots i] [qSlots i]) (return 0)))
 (for ((= i 0)) (< i 63) ((++ i)) (if (!= [q8Reservations i] [qReserve i]) (return 0)))
 (return (self qValidateLayout:)))

(method (q8Valid &tmp i j slot)
 (if (not (self qValidateLayout:)) (return 0))
 (if (not qInventoryStarted) (return 1))
 (for ((= i 0)) (< i 63) ((++ i))
  (= slot [qReserve i])
  (if (>= slot 0) (for ((= j 0)) (< j i) ((++ j)) (if (== [qReserve j] slot) (return 0))))) (return 1))

(method (q8StageValid &tmp i j obj slot)
 (if (or (< q8Extent 0) (> q8Extent 64)) (return 0))
 (for ((= i 0)) (< i 64) ((++ i))
  (= obj [q8Slots i])
  (if (or (< obj 0) (> obj 62) (and (> obj 50) (!= obj OBJ_WELCOME_BUNTING)) (and (>= i q8Extent) obj)) (return 0))
  (if obj (for ((= j 0)) (< j i) ((++ j)) (if (== [q8Slots j] obj) (return 0)))))
 (for ((= i 0)) (< i 63) ((++ i))
  (= slot [q8Reservations i])
  (if (or (< slot -1) (>= slot q8Extent)) (return 0))
  (if (>= slot 0)
   (if [q8Slots slot] (return 0))
   (for ((= j 0)) (< j i) ((++ j)) (if (== [q8Reservations j] slot) (return 0)))))
 (return 1))

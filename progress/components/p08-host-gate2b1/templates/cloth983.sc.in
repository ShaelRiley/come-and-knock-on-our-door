; Read-only complete P03 inventory reservation for the original returned cloth.
(method (b8Valid &tmp i j obj slot)
 (if (or (< bInventoryStarted 0) (> bInventoryStarted 1) (< bExtent 0) (> bExtent 64)) (return 0))
 (for ((= i 0)) (< i 64) ((++ i))
  (= obj [bSlots i])
  (if (or (< obj 0) (> obj 50) (and (>= i bExtent) obj)) (return 0))
  (if obj (for ((= j 0)) (< j i) ((++ j)) (if (== [bSlots j] obj) (return 0)))))
 (if (not bInventoryStarted) (return (== bExtent 0)))
 (if (or (< bLastRoom 0) (> bLastRoom 6)) (return 0))
 (for ((= i 0)) (< i 51) ((++ i))
  (= slot [bReserve i])
  (if (or (< slot -1) (>= slot bExtent)) (return 0))
  (if (and (>= slot 0) [bSlots slot]) (return 0))
  (if (>= slot 0) (for ((= j 0)) (< j i) ((++ j)) (if (== [bReserve j] slot) (return 0))))) (return 1))
(method (b8Item index) (if (or (< index 0) (>= index 64)) (return 0)) (return [b8Slots index]))
(method (b8CurrentItem index) (if (or (< index 0) (>= index 64)) (return 0)) (return [bSlots index]))
(method (b8Held h obj change)
 (if (== obj (if (< change 0) (- 0 change) else change)) (return (> change 0)))
 (return (self bHeld: h obj)))
(method (b8Append obj &tmp i slot)
 (if (not obj) (return 1)) (if (or (< obj 1) (> obj 50)) (return 0))
 (for ((= i 0)) (< i b8Extent) ((++ i)) (if (== [b8Slots i] obj) (return 1)))
 (= slot [b8Reservations obj])
 (if (and (>= slot 0) (< slot b8Extent) (== [b8Slots slot] 0)) (= [b8Slots slot] obj)
  else (if (>= b8Extent 64) (return 0)) (= [b8Slots b8Extent] obj) (++ b8Extent))
 (= [b8Reservations obj] -1) (return 1))
(method (b8Prepare h change &tmp i j obj compact)
 (= b8Prepared 0)
 (if (or bFailure (not (self b8Valid:)) (not bInventoryStarted) (not (h p02PlanAgreed?))
  (< (h p02InventoryExtent?) 0) (> (h p02InventoryExtent?) 64)) (return 0))
 (= b8Extent bExtent) (= compact (!= bLastRoom (h location?)))
 (for ((= i 0)) (< i 64) ((++ i)) (= [b8Slots i] [bSlots i]))
 (for ((= i 0)) (< i 51) ((++ i)) (= [b8Reservations i] [bReserve i]))
 (for ((= i 0)) (< i b8Extent) ((++ i))
  (= obj [b8Slots i])
  (if (and obj (not (self b8Held: h obj change))) (= [b8Reservations obj] i) (= [b8Slots i] 0)))
 (for ((= i 0)) (< i (h p02InventoryExtent?)) ((++ i))
  (= obj (h p02InventoryItem: i))
  (if (or (< obj 0) (> obj 32)) (return 0))
  (if (and obj (h p03HostExternalHeld: obj)) (if (not (self b8Append: obj)) (return 0))))
 (if (h p03HostExternalHeld: OBJ_NEWSPAPER) (if (not (self b8Append: OBJ_NEWSPAPER)) (return 0)))
 (for ((= i 0)) (< i 3) ((++ i)) (if (not (self b8Append: (self p03InventoryAt: i))) (return 0)))
 (if (> change 0) (if (not (self b8Append: change)) (return 0)))
 (if compact
  (= j 0) (for ((= i 0)) (< i b8Extent) ((++ i)) (if [b8Slots i] (= [b8Slots j] [b8Slots i]) (++ j)))
  (for ((= i j)) (< i 64) ((++ i)) (= [b8Slots i] 0)) (= b8Extent j)
  (for ((= i 0)) (< i 51) ((++ i)) (= [b8Reservations i] -1)))
 (if (not (self b8StageValid:)) (return 0))
 (= b8Prepared 1) (return 1))
(method (b8Matches &tmp i)
 (if (or (not b8Prepared) (!= b8Extent bExtent)) (return 0))
 (for ((= i 0)) (< i 64) ((++ i)) (if (!= [b8Slots i] [bSlots i]) (return 0)))
 (for ((= i 0)) (< i 51) ((++ i)) (if (!= [b8Reservations i] [bReserve i]) (return 0))) (return 1))

(method (b8StageValid &tmp i j obj slot)
 (if (or (< b8Extent 0) (> b8Extent 64)) (return 0))
 (for ((= i 0)) (< i 64) ((++ i))
  (= obj [b8Slots i])
  (if (or (< obj 0) (> obj 50) (and (>= i b8Extent) obj)) (return 0))
  (if obj (for ((= j 0)) (< j i) ((++ j)) (if (== [b8Slots j] obj) (return 0)))))
 (for ((= i 0)) (< i 51) ((++ i))
  (= slot [b8Reservations i])
  (if (or (< slot -1) (>= slot b8Extent)) (return 0))
  (if (>= slot 0)
   (if [b8Slots slot] (return 0))
   (for ((= j 0)) (< j i) ((++ j)) (if (== [b8Reservations j] slot) (return 0)))))
 (return 1))

; Stateless modal UI filter. Saved intent and all publication stay in P08.
(method (h8VI cmd action object target &tmp owner controller key index kind payload)
 (= owner h8Host) (= controller self)
 (if (or (!= controller (ScriptID 989 0)) (!= owner (controller h8Host?))) (return 0))
 (if (or (== cmd 4) (== cmd 5))
  (if (or (!= [h8VP 0] 3) (owner opening?) (owner paused?) (owner menuOpen?) (!= (owner uiPanel?) 4)) (return 0))
  (if (== cmd 4)
   (if (!= (owner h8VI: action 0) 12) (return 0))
  else (if (or (!= (owner type?) 4) (!= (owner message?) 27)) (return 0)))
  (return (not (self h8VR: 12 (if (== cmd 4) 1 else 2)))))
 (if (== cmd 1)
  (if (and (== (controller h8V: 10 0) 2) (== action 6) (== object 8) (not target)
   (not (owner uiPanel?)) (not (owner paused?)) (not (owner menuOpen?))
   (== (controller h8ActorRoom: 3) 4) (controller h8VC: 1))
   (controller h8VR: 1 0) (return 1)) (return 0))
 (if (== cmd 2)
  (if (and (>= (controller h8V: 10 0) 2) (controller h8VC: 1))
   (owner uiAddControl: 1 8 63 66 131 89 (owner uiHostItemLabel: 8))) (return 1))
 (if (!= cmd 0) (return 0))
 (= key (owner message?))
 (if (and (== (owner type?) 4) (or (== key 15360) (== key 15616))) (return 0))
 (if (or (controller h8Failure?) (controller h8Restoring?) (not (controller h8RestoreValid?))) (return 1))
 (if (or (owner paused?) (owner menuOpen?)) (return 0))
 (if (and (== (owner type?) 4)
  (or (== key 109) (== key 27) (== key 118) (== key 101) (== key 97) (== key 121)
   (== key 91) (== key 93) (== key 44) (== key 46) (== key 43) (== key 45) (== key 61) (== key 114))) (return 0))
 (if (< (controller h8V: 10 0) 2) (return 1))
 (if (owner uiPanel?) (return 0))
 (if (== (owner type?) 4)
  (if (or (== key 9) (== key 3840) (== key 19200) (== key 19712) (== key 18432) (== key 20480) (== key 32)) (return 0))
  (if (!= key 13) (return 1)) (= index (owner uiFocus?))
 else (if (!= (owner type?) 1) (return 1)) (= index (owner uiHit: (owner x?) (owner y?))))
 (if (< index 0) (return 1)) (= kind (owner h8VI: index 0)) (= payload (owner h8VI: index 1))
 (return (not (or (and (== kind 1) (== payload 8)) (== kind 2) (== kind 4) (== kind 5)
  (== kind 6) (== kind 7) (== kind 8)))))

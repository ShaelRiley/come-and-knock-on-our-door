; NEW courtyard art reconstruction. Static-only reviewed source fragment.
; Append these methods to P05State985; host owns selector assignment/compilation.
; DrawCel305/228 and reused227 use palette999/font0. No model/owner mutation.
(method (hCourtVisible)
    (return (and hHost (not (hHost onApron?)) (== (hHost location?) 4)
        (== hPAOwner 1) (== hPARoom 4) (self p05NZ: S_COMPLETE))))
(method (hCourtControls)
    (if (or (not hHost) (hHost onApron?) (!= (hHost location?) 4)) (return 0))
    (hHost uiAddControl: 1 18 44 22 102 64 "LIVING ROOM")
    (hHost uiAddControl: 1 19 44 282 111 315 "SIDE GATE")
    (hHost uiAddControl: 1 9 119 306 144 320 "AUDIENCE EDGE")
    (if (self hCourtVisible:)
        (self hControl: 71 137 103 162 127)
        ; Carve kit around exit19 so control iteration order cannot steal gate.
        (self hControl: 63 164 61 282 129)
        (self hControl: 63 282 111 291 129))
    (hHost uiAddControl: 1 32 2 160 12 211 "NOTES")
    (return 1))
(method (hCourtApproachX obj)
    (switch obj
        (18 (return 44))
        (19 (return 279))
        (9 (return 291))
        (63 (return 114))
        (71 (return 111))
    )
    (return 114))
(method (hCourtApproachY obj)
    (switch obj
        (18 (return 124))
        (19 (return 132))
        (9 (return 140))
        (63 (return 140))
        (71 (return 139))
    )
    (return 140))
(method (hCourtScale) (return 127))
(method (hCourtRender &tmp p4)
    (if (or (not hHost) (hHost onApron?) (!= (hHost location?) 4)) (return 0))
    (DrawCel 305 0 0 0 0 -1 0)
    (= p4 (hHost p04?))
    ; Physical gate only: OPEN1 shows base; RESTING0/CLOSED2 show closed layer.
    (if (or (not p4) (!= (p4 p04Gate?) 1)) (DrawCel 228 0 11 281 36 -1 0))
    (DrawCel 228 0 7 80 110 -1 0)
    (DrawCel 228 0 8 149 110 -1 0)
    (DrawCel 228 0 9 221 110 -1 0)
    (DrawCel 228 0 10 23 132 -1 0)
    (if (self hCourtVisible:)
        (if (== [p05Words 66] 1) (DrawCel 227 0 6 174 92 -1 0) else (DrawCel 227 0 5 173 110 -1 0))
        (DrawCel 227 0 0 184 92 -1 0)
        (DrawCel 227 0 9 195 71 -1 0)
        (DrawCel 227 0 (+ 10 [p05Words 67]) 185 84 -1 0)
        (if (== [p05Words 66] 1) (DrawCel 227 0 13 225 92 -1 0) else (DrawCel 227 0 12 234 92 -1 0))
        (DrawCel 227 0 4 164 91 -1 0)
        (DrawCel 227 0 (+ 1 [p05Words 68]) 254 61 -1 0)
        (DrawCel 227 0 8 137 103 -1 0)
        (Display "TAPE" 100 185 84 102 0 105 0 106 24 121)
        (Display "MIC" 100 212 84 102 0 105 0 106 18 121))
    ; Main sets scale127 for courtyard walking/approaches before drawJack.
    ; Return1 suppresses the old blockout and prevents a second actor draw.
    (hHost drawJack:)
    (return 1))

; Additive host-only P05 courtyard controls. Native art pixels unchanged.
(method (hCourtControls)
 (if (or (not hHost) (hHost onApron?) (!= (hHost location?) 4)) (return 0))
 (hHost uiAddControl: 1 18 44 22 102 64 "LIVING ROOM")
 (hHost uiAddControl: 1 19 44 282 111 315 "SIDE GATE")
 (hHost uiAddControl: 1 9 119 306 144 320 "AUDIENCE EDGE")
 (if (self hCourtVisible:)
  (self hControl: 71 137 103 162 127)
  (self hControl: 64 183 83 233 113)
  (self hControl: 65 162 89 184 127)
  (self hControl: 66 233 90 253 114)
  (self hControl: 67 254 59 282 106)
  (self hControl: 68 251 106 282 125)
  (self hControl: 68 282 111 292 125)
  (self hControl: 70 192 68 226 84)
  (self hControl: 63 164 61 254 68)
  (self hControl: 63 164 68 192 83)
  (self hControl: 63 226 68 254 83)
  (self hControl: 63 164 127 282 129)
  (self hControl: 63 184 125 282 127)
  (self hControl: 63 184 114 251 125)
  (self hControl: 63 184 113 233 114)
  (self hControl: 63 164 83 183 89)
  (self hControl: 63 233 83 254 90)
  (self hControl: 63 253 90 254 106)
  (self hControl: 63 282 125 291 129)
 )

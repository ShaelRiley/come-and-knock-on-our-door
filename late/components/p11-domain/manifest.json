    {
      "line_id": "P11.DIALOGUE.001.01",
      "record_id": "P11.DIALOGUE.001",
      "speaker_id": "bunny",
      "speaker": "Bunny Easter",
      "text": "Jackie? You said you were stuck. Are you hurt?",
      "caption_text": "Jackie? You said you were stuck. Are you hurt?",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.001.02",
      "record_id": "P11.DIALOGUE.001",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "We\u2019re unhurt. The display wing has us wedged in.",
      "caption_text": "We\u2019re unhurt. The display wing has us wedged in.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.001.03",
      "record_id": "P11.DIALOGUE.001",
      "speaker_id": "frankie",
      "speaker": "Frankie Maplewood",
      "text": "Keep supporting it. Bunny can reach the peg; I can reach the catch.",
      "caption_text": "Keep supporting it. Bunny can reach the peg; I can reach the catch.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.001.04",
      "record_id": "P11.DIALOGUE.001",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "It\u2019s a moving exhibit.",
      "caption_text": "It\u2019s a moving exhibit.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.001.05",
      "record_id": "P11.DIALOGUE.001",
      "speaker_id": "bunny",
      "speaker": "Bunny Easter",
      "text": "Lovely. Shall we help, or wait for the next performance?",
      "caption_text": "Lovely. Shall we help, or wait for the next performance?",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": {
        "strength": 1,
        "beat": "after_line",
        "canonical_cue_id": null,
        "canonical_binding_role": null,
        "double_fire_allowed": false,
        "editorial_only": true,
        "runtime_policy": "Existing separately authorized speech/laugh presentation policy; never alter puzzle state. Suppress on quiet repeats, boundaries, apparent injury or sincere follow-up."
      }
    },
    {
      "line_id": "P11.DIALOGUE.002.01",
      "record_id": "P11.DIALOGUE.002",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "I\u2019d like people to trust a repair because it works. Not because I\u2019ve made a speech.",
      "caption_text": "I\u2019d like people to trust a repair because it works. Not because I\u2019ve made a speech.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.002.02",
      "record_id": "P11.DIALOGUE.002",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "You do like the speech.",
      "caption_text": "You do like the speech.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.002.03",
      "record_id": "P11.DIALOGUE.002",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "I like people knowing I did the work.",
      "caption_text": "I like people knowing I did the work.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.002.04",
      "record_id": "P11.DIALOGUE.002",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "I keep saying I can manage everything.",
      "caption_text": "I keep saying I can manage everything.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.002.05",
      "record_id": "P11.DIALOGUE.002",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "You can manage this end. I can manage that end.",
      "caption_text": "You can manage this end. I can manage that end.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.DIALOGUE.002.06",
      "record_id": "P11.DIALOGUE.002",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "And we can ask them to manage the rest.",
      "caption_text": "And we can ask them to manage the rest.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.LOOK.001.01",
      "record_id": "P11.LOOK.001",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "The catch has two arrows pointing inward. Release it and the wing folds. We\u2019re carrying the wide version for no extra money.",
      "caption_text": "The catch has two arrows pointing inward. Release it and the wing folds. We\u2019re carrying the wide version for no extra money.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.LOOK.002.01",
      "record_id": "P11.LOOK.002",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "The gate\u2019s proper hold-open peg is on the far side. Bunny can reach it from the porch.",
      "caption_text": "The gate\u2019s proper hold-open peg is on the far side. Bunny can reach it from the porch.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.LOOK.003.01",
      "record_id": "P11.LOOK.003",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "Frankie can reach the catch from the courtyard. I can reach plywood with parts of myself I normally keep private.",
      "caption_text": "Frankie can reach the catch from the courtyard. I can reach plywood with parts of myself I normally keep private.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.SUCCESS.001.01",
      "record_id": "P11.SUCCESS.001",
      "speaker_id": "bunny",
      "speaker": "Bunny Easter",
      "text": "Gate pegged. It can\u2019t swing into you.",
      "caption_text": "Gate pegged. It can\u2019t swing into you.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.SUCCESS.001.02",
      "record_id": "P11.SUCCESS.001",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "Thank you. I was running out of places to be hit.",
      "caption_text": "Thank you. I was running out of places to be hit.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": {
        "strength": 1,
        "beat": "after_line",
        "canonical_cue_id": null,

      "record_id": "P11.SUCCESS.005",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "Together. Fold. Onto the padded stops. Down to the cart.",
      "caption_text": "Together. Fold. Onto the padded stops. Down to the cart.",

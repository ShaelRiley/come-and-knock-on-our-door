    {
      "line_id": "P11.OPEN.001.02",
      "record_id": "P11.OPEN.001",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "I can see that.",
      "caption_text": "I can see that.",
      "dynamic_bindings": {},

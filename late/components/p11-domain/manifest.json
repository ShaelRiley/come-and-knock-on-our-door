      "laugh_opportunity": null
    },
    {
      "line_id": "P11.OPEN.001.03",
      "record_id": "P11.OPEN.001",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "Can you see the corner?",
      "caption_text": "Can you see the corner?",

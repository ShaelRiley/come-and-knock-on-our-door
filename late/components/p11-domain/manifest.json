        "runtime_policy": "Existing separately authorized speech/laugh presentation policy; never alter puzzle state. Suppress on quiet repeats, boundaries, apparent injury or sincere follow-up."
      }
    },
    {
      "line_id": "P11.SUCCESS.002.01",
      "record_id": "P11.SUCCESS.002",
      "speaker_id": "bunny",
      "speaker": "Bunny Easter",
      "text": "The proper peg is already in. Good. One bit of this doesn\u2019t need an elbow.",
      "caption_text": "The proper peg is already in. Good. One bit of this doesn\u2019t need an elbow.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.SUCCESS.003.01",
      "record_id": "P11.SUCCESS.003",
      "speaker_id": "frankie",
      "speaker": "Frankie Maplewood",
      "text": "Catch released. Now pull the display handle with Felix. Fold it onto the padded stops.",
      "caption_text": "Catch released. Now pull the display handle with Felix. Fold it onto the padded stops.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.FAILURE.001.01",
      "record_id": "P11.FAILURE.001",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "Fold it, don\u2019t force it. The catch releases the wing. The passage won\u2019t widen just because we make that noise.",
      "caption_text": "Fold it, don\u2019t force it. The catch releases the wing. The passage won\u2019t widen just because we make that noise.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.FAILURE.002.01",
      "record_id": "P11.FAILURE.002",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "We need the gate held on its proper peg. Bunny can reach it from that side.",
      "caption_text": "We need the gate held on its proper peg. Bunny can reach it from that side.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.FAILURE.003.01",
      "record_id": "P11.FAILURE.003",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "The wing catch is still fastened. Ask Frankie to release the one with the inward arrows.",
      "caption_text": "The wing catch is still fastened. Ask Frankie to release the one with the inward arrows.",

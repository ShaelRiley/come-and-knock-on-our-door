      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {
      "line_id": "P11.SUCCESS.004.01",
      "record_id": "P11.SUCCESS.004",
      "speaker_id": "felix",
      "speaker": "Felix Bunt",
      "text": "Back on the padded cart. Safely. We can walk round and sort it out without having a conversation through wood.",
      "caption_text": "Back on the padded cart. Safely. We can walk round and sort it out without having a conversation through wood.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",
      "laugh_opportunity": null
    },
    {

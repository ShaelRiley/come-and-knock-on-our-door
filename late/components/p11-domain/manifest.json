    },
    {
      "line_id": "P11.OPEN.001.04",
      "record_id": "P11.OPEN.001",
      "speaker_id": "jack",
      "speaker": "Jackie Tree",
      "text": "I could identify it blindfolded.",
      "caption_text": "I could identify it blindfolded.",
      "dynamic_bindings": {},
      "implementation_status": "authored_gdd_not_implemented",

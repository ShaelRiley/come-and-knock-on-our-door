; Bounded courtyard UI. h8UI: generation, context, object, verb, room,
; revision hi/lo, publication requested, base, old count/index, reader, active,
; overlap bypass, overlap mask, original noun, reserved flag/count. No gameplay model.
(method (h8LayoutActive)
 (return (if (and h8Host h8Enabled (not (self h8ActionBarrier:))
  (== (h8Host location?) 4) (not (h8Host onApron?)) (h8Host p02PlanAgreed?)
  ((h8Host p03?) p03Ready?) ((h8Host p04?) p04Ready:)
  (== (& ((h8Host p05?) p05Flags:) 7) 7)
  (== (& ((h8Host p05?) hContestFlags:) 3) 3)
  (== (& ((h8Host p06?) p06Projection: 0) 7) 7)
  (& ((h8Host p07?) p07Projection: 0) 2)) 1 else 0)))
(method (h8LayoutInput)

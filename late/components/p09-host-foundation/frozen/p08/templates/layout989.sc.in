  (= x 137) (= y 103)
 else (= x (+ (self h8LayoutOrigin: 1 pos 0) 55))
  (= y (+ (self h8LayoutOrigin: 1 pos 1) (if (== pos 4) 21 else 27))))
 (DrawCel 227 0 8 x y -1 0)
 (Display "Courtyard plan overlay" 100 6 15 102 1 105 0 106 146 121)

 (if (not ((h p08?) p08EveningStarted?))
  (if (or p09RevisionHi p09RevisionLo) (return 0))) (return 1))
(method (dProject h &tmp obj c epoch)
 (if (or dInvalid (not (self dValidateHost: h))) (return 0))
 (= c (h p08?)) (if (not c) (return 0))
 (= epoch (self dEpochNext:)) (if (not epoch) (return 0))
 (if (not (self p09Context: (h location?) (h onApron?) (c p08EveningStarted?) (h p02PlanAgreed?)
  (c cActorRoom: h 4) (c cActorRoom: h 7) dView (h p05ContestActive:) 0 0 epoch)) (return 0))
 ; Other branch arrays only know their own namespaces. Never project card399.
 (for ((= obj 1)) (<= obj 110) ((++ obj))
  (if (h campaignHeld: obj) (if (not (self p09ContextItem: obj)) (return 0))))
 (return (self p09ValidateContext:)))
(method (dContextMatches h &tmp c)
 (= c (h p08?))
 (return (and p09ContextValid (== p09Room (h location?)) (== p09Apron (h onApron?))
  (== p09Evening (c p08EveningStarted?)) (== p09Plan (h p02PlanAgreed?))
  (== p09StringerRoom (c cActorRoom: h 4)) (== p09RitaRoom (c cActorRoom: h 7))
  (== p09View dView) (== p09ContestActive (h p05ContestActive:)))))
(method (dCancel)

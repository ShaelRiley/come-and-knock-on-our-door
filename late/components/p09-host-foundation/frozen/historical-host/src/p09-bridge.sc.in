; Original P09 host integration. Canonical p09* domain methods remain unchanged.
(method (dEpochNext &tmp candidate handle count closed [filename 16] [written 2] [readback 3])
 ; External, append-only reservations survive RestoreGame. Never run per frame.
 (= dEpochFailure 0) (= candidate dEpoch)
 (if (or (< candidate 0) (>= candidate 32767)) (= dEpochFailure 2) (return 0))
 (++ candidate) (Format @filename "p09e%05d.dat" candidate)
 (while (FileIO 10 @filename)
  (if (>= candidate 32767) (= dEpochFailure 2) (return 0))
  (++ candidate) (Format @filename "p09e%05d.dat" candidate))
 (= handle (FileIO 0 @filename 2))
 (if (== handle -1) (= dEpochFailure 1) (return 0))
 (= [written 0] 17345) (= [written 1] candidate)
 (= count (FileIO 3 handle @written 4)) (= closed (FileIO 1 handle))
 (if (or (!= count 4) (not closed)) (= dEpochFailure 1) (return 0))
 (= handle (FileIO 0 @filename 1))
 (if (== handle -1) (= dEpochFailure 1) (return 0))
 (= [readback 0] 0) (= [readback 1] 0) (= [readback 2] 0)
 (= count (FileIO 2 handle @readback 5)) (= closed (FileIO 1 handle))
 (if (or (!= count 4) (not closed) (!= [readback 0] 17345) (!= [readback 1] candidate))
  (= dEpochFailure 1) (return 0))
 (= dEpoch candidate) (return dEpoch))
(method (dOwnersValid)

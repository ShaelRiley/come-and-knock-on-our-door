 (if (not dPending) (return 1)) (= d (h dialogue?))
 (if (h scenePageIdentity:)
  (= dDocument (h uiDocument?)) (= dDisplayPage (h uiPage?)) (= dGeneration (d sdGeneration?))) (return 1))
(method (dReconcile)
 (if (not p09Ready) (return (self dOwnersValid:)))
 (if (not dOwned)
  (= dOwned 1) (= dGrantHi (self p09SerialHi: 2)) (= dGrantLo (self p09SerialLo: 2)))

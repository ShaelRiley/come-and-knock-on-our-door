  (if (or (< (d sdRoute: doc) 0) (!= (d sdPageCount: doc) (self dExpectedPages: doc))) (return 0)))
 (return 1))
(method (dQueue h doc &tmp count d)
 (= count (h bridgeQueueCount?)) (= d (h dialogue?))
 (if (or (h bridgeSilent?) (< count 0) (>= count 32) (not (self dExpectedPages: doc))
  (< (d sdRoute: doc) 0) (!= (d sdPageCount: doc) (self dExpectedPages: doc))) (return 0))
 (if (not (d sdQueueSet: count 1)) (return 0))
 (h p06QueueSet: count doc) (h bridgeQueueCount: (+ count 1)) (return 1))
(method (dCapture &tmp i doc)
 (= dCode p09Code) (= dSource p09PresentationSource)
 (= dReceiptHi p09PresentationHi) (= dReceiptLo p09PresentationLo) (= dReceiptEpoch p09Epoch)
 (= dCount 0)
 (for ((= i 0)) (< i p09LineCount) ((++ i))
  (= doc (+ 1099 (self p09Line: i))) (= [dDocs dCount] doc) (++ dCount))
 (for ((= i 0)) (< i p09UnitCount) ((++ i))
  (= doc (+ 1119 (self p09Unit: i))) (= [dDocs dCount] doc) (++ dCount))
 (if (> dCount 14) (return 0))

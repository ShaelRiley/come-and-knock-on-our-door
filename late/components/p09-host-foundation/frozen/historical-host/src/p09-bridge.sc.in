(method (dPresented h document page generation epoch &tmp d unit record before code)
 (if (not dPending) (return 0)) (= d (h dialogue?))
 (if (or (<= epoch 0) (!= epoch dReceiptEpoch) (!= epoch dPaintEpoch)) (return 0))
 (if (or (not (self dContextMatches: h)) (not (self dValidateHost: h))) (self dCancel:) (return 0))
 (if (or (h opening?) (h paused?) (h menuOpen?) (h uiFailure?) (h bridgeFailure?) (h motionPhase?)
  (d sdFailure?) (not (h scenePageIdentity:)) (!= document dDocument) (!= page dDisplayPage)
  (!= generation dGeneration) (!= generation (d sdGeneration?)) (!= generation (d sdPaintGeneration?))) (return 0))
 (if (or (< dCursor 0) (>= dCursor dCount) (!= document [dDocs dCursor]) (!= page dPage)) (return 0))
 (if (!= (self dExpectedPages: document) (d sdPageCount: document)) (= dFailure 2) (self dCancel:) (return 0))
 (= unit (self dPageUnitEnd: document page)) (= record 0)
 (if (and (not unit) (== (+ page 1) (self dExpectedPages: document)) (< document 1120))
  (= record (- document 1099))
  (if (self p09RecordSize: record)
   (if (self p09TokenUnit: (self p09RecordFirst: record)) (= record 0))
  else (= record 0)))
 (if (and dSource (or unit record))
  (if (and (== dSource SOURCE_TERMS) (not p09Ready) (>= (h uiInventoryExtent?) 64)) (= dFailure 2) (return 0))
  (self dSnapshot:) (= before p09Ready)
  (= code (self p09Acknowledge: dSource dReceiptHi dReceiptLo dReceiptEpoch record unit unit))
  (if (or (!= code CODE_PRESENTATION_ACKNOWLEDGED) (not (self dReconcile:)))
   (self dRollback:) (self dCancel:) (= dFailure 1) (return 0))
  (if (and (not before) p09Ready) (h p02HostInventory:)))
 (++ dPage) (if (>= dPage (self dExpectedPages: document)) (++ dCursor) (= dPage 0))
 (if (>= dCursor dCount)
  (= dPending 0)
  ; Terms grant and success are separate receipts and separate visible scenes.
  (if (and (== dSource SOURCE_TERMS) p09Ready (< (self p09Count: SOURCE_TERMS) 6)) (= dNextMenu 1)))
 (return 1))
(method (dClosed h &tmp current)
 (if dPending (= current (- (h bridgeQueueIndex?) 1))
  (if (or (< current 0) (>= current dCount) (<= dCursor current)) (self dCancel:))) (return 1))

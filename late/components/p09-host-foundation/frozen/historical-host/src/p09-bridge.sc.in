(method (dInvoke mode action obj target)
 (switch mode
  (1 (return (self p09Act: action obj target)))
  (2 (return (self p09Begin: obj)))
  (3 (return (self p09Ask:)))
  (4 (return (self p09Hint: action)))
  (5 (return (self p09Resume: obj)))) (return 0))
(method (dRun h mode action obj target &tmp before i)
 (= dFailure 0) (if dTransaction (= dFailure 1) (return 0)) (self dCancel:)
 (if (or (not dEnabled) (not (self dRoutesReady: h))) (= dFailure 2) (return 0))
 (if (not (self dProject: h)) (= dFailure (if dEpochFailure 3 else 1)) (return 0))
 (= before (h bridgeQueueCount?))
 (if (or (h bridgeSilent?) (!= before 0)) (= dFailure 2) (return 0))
 (self dSnapshot:) (= dTransaction 1) (self dInvoke: mode action obj target)
 (self dPresentAvailablePrefix: mode obj)
 (if (or (not (self p09ValidateContext:)) (not (self dCapture:)))
  (self dRollback:) (= dTransaction 0) (= dFailure 1) (return 0))
 (for ((= i 0)) (< i dCount) ((++ i))
  (if (not (self dQueue: h [dDocs i]))
   (h p04RollbackQueue: before) (self dRollback:) (= dTransaction 0)
   (self dCancel:) (= dFailure 2) (return 0)))
 (= dPending (if dCount 1 else 0)) (= dTransaction 0) (h dirty: 1) (return 1))

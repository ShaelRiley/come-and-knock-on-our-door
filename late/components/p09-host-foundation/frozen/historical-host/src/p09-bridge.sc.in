(method (dPresentAvailablePrefix mode obj)
 ; A full accusation interrupted by Rita's departure still permits Stringer's
 ; first exact correction. Resume has armed the existing source lease already.
 (if (and (or (== mode 2) (== mode 5)) (== obj SOURCE_ACCUSATION)
  (== p09Code CODE_SPEAKER_ABSENT) (self p09Present: (+ SOURCE_ACCUSATION 3))
  (== (self p09Count: SOURCE_ACCUSATION) 0) (== p09StringerRoom 6) (!= p09RitaRoom 6))
  (= [p09Units 0] UNIT_P09_FAILURE_001_01) (= p09UnitCount 1)

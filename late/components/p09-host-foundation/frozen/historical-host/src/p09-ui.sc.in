(method (dLabel obj)
 (switch obj (395 (return "TAGGED CHAIRS")) (396 (return "CHAIR TAG"))
  (397 (return "CONSERVATORY FRONT")) (398 (return "CONSERVATORY SIDE"))
  (399 (return "RENEWAL AND REPAIR CARD"))) (return "CONSERVATORY"))
(method (dDefaultVerb obj)
 (if (or (== obj 397) (== obj 398)) (return 0)) (if (== obj 399) (return 2)) (return 5))
(method (dApproachX obj)
 (switch obj (395 (return 190)) (396 (return 190)) (397 (return 242)) (398 (return 122))) (return 190))
(method (dApproachY obj) (return 136))
(method (dWorldControls h)
 (if (or (h onApron?) (!= (h location?) 6) (not ((h p08?) p08EveningStarted?))) (return 0))
 ; Background chairs are existing scenery; these do not create movable objects.
 (h uiAddControl: 1 395 72 179 109 201 "TAGGED CHAIRS")
 (h uiAddControl: 1 396 76 184 88 194 "CHAIR TAG")
 (h uiAddControl: 1 396 76 207 88 217 "CHAIR TAG")
 (h uiAddControl: 1 397 132 230 143 270 "FRONT VIEW")
 (h uiAddControl: 1 398 132 101 143 141 "SIDE VIEW") (return 1))
(method (dDispatch h action obj target)
 (if (and (== obj 32) (not target) (or (== (h location?) 6) p09Ready) ((h p08?) p08EveningStarted?)
  (or (== action 2) (== action 5))) (self dChoices: h 234) (return 1))
 (if (not (or (self dHandles: h obj) (self dHandles: h target))) (return 0))
 (if (not action) (= action (if (or (== obj 397) (== obj 398)) 7 else (self dDefaultVerb: obj))))
 (if (and (not target) (== action 6) (or (== obj 29) (== obj 30)))
  (if (self dReachable: h obj) (self dChoices: h 233)) (return 1))
 (if (and (not target) (or (== obj 397) (== obj 398)) (or (== action 7) (== action 5)))
  (if (not (self dReachable: h obj)) (return 1))
  (= dView (if (== obj 397) 1 else 0))
  (self dRun: h 2 0 (if dView SOURCE_FRONT_CONTEXT else SOURCE_INTRO) 0)
 else
  (if (and (not target) (or (== action 5) (== action 2)) (== obj 395))
   (self dRun: h 2 0 SOURCE_CHAIRS 0)
  else (if (and (not target) (or (== action 5) (== action 2)) (== obj 396))
   (self dRun: h 2 0 SOURCE_CHAIR_TAG 0)
  else (self dRun: h 1 action obj target))))
 (self dFinish: h) (return 1))
(method (dChoices h context &tmp i line unit source)
 (self dCancel:) (= dFailure 0)
 (h bridgeReaderActive: 0) (h uiClearChoices: "CONSERVATORY" context 0)
 (if (== context 233)
  (if (not (self dProject: h)) (= dFailure (if dEpochFailure 3 else 1)) (self dFinish: h) (return 0))
  (self p09Topics:)
  (for ((= i 0)) (< i p09LineCount) ((++ i))
   (= line (self p09Line: i)) (h uiAddChoice: line (self dChoiceLabel: line) 0 1))
  (h uiAddChoice: 50 "A HINT" 0 1)
  (h uiAddChoice: 51 "PENDING CONVERSATIONS AND EVIDENCE" 0 1)
 else (if (== context 234)
  (for ((= i 0)) (< i 9) ((++ i))
   (= source (self p09PendingAt: i))
   (if source (h uiAddChoice: (+ 100 source) (self dSourceLabel: source) 0 1)))
  (for ((= i 0)) (< i 20) ((++ i))
   (= line (self p09JournalAt: i 0))
   (if line (h uiAddChoice: (+ 200 line) (self dRecordLabel: line) 0 1)))
  (h uiAddChoice: 52 "EXACT RECORDED LINES" 0 1)
  (h uiAddChoice: 53 "EARLIER HOUSEHOLD EVIDENCE" 0 1)
 else (if (== context 235)
  (for ((= i 0)) (< i 20) ((++ i))
   (= unit (self p09JournalAt: i 1))
   (if unit (h uiAddChoice: (+ 300 unit) (self dUnitLabel: unit) 0 1)))))) (return 1))
(method (dChoice h context id &tmp line i found)
 (h bridgeBegin:)
 (if (== context 233)
  (switch id
   (LINE_P09_CHOICE_001 (self dRun: h 3 0 0 0))
   (LINE_P09_CHOICE_002 (self dRun: h 2 0 SOURCE_ACCUSATION 0))
   (LINE_P09_CHOICE_003 (self dRun: h 2 0 SOURCE_TERMS 0))
   (LINE_P09_CHOICE_004 (self dRun: h 2 0 SOURCE_SHARED_WISH 0))
   (50 (self dRun: h 4 0 0 0))
   (51 (self dChoices: h 234) (return 1))))
 (if (== context 234)
  (if (and (> id 100) (< id 110)) (self dRun: h 5 0 (- id 100) 0)
  else (if (and (> id 200) (<= id 220))
   (= found 0) (for ((= i 0)) (< i 20) ((++ i))
    (if (== (- id 200) (self p09JournalAt: i 0)) (= found 1)))
   (if found (self dQueue: h (+ 899 id)))
  else (if (== id 52) (self dChoices: h 235) (return 1)
  else (if (== id 53) ((h p07?) kChoices: h 225) (return 1))))))
 (if (and (== context 235) (> id 300) (<= id 320))
  (= found 0) (for ((= i 0)) (< i 20) ((++ i))
   (if (== (- id 300) (self p09JournalAt: i 1)) (= found 1)))
  (if found (self dQueue: h (+ 819 id))))
 (self dFinish: h))
(method (dStatus)
 (switch dCode
  (CODE_EVENING_REQUIRED (return "THE EVENING HAS NOT STARTED."))
  (CODE_SPEAKER_ABSENT (return "THE SPEAKER IS ELSEWHERE."))
  (CODE_OFFSCREEN (return "OUT OF REACH."))
  (CODE_CONTEST_ACTIVE (return "FINISH THE CONVERSATION FIRST."))
  (CODE_UNSIGNED_CARD_RESERVED_FOR_P14 (return "THE CARD REMAINS UNSIGNED."))
  (CODE_TERMS_CARD_AVAILABLE (return "UNSIGNED CARD IN INVENTORY."))
  (CODE_PRESENTATION_COMPLETE (return "ALREADY RECORDED."))
  (CODE_RUMOR_ALREADY_CLEARED (return "THE THREE CHAIRS HAVE BEEN IDENTIFIED.")))
 (return "NO CHANGE."))
(method (dCanSpeak h who)
 (if (or (h opening?) (h paused?) (h menuOpen?) (h motionPhase?) (h onApron?) ((h p08?) cMove?)) (return 0))
 (if (== who 1) (return 1))
 (if (or (== who 4) (== who 7)) (return (== (h location?) ((h p08?) cActorRoom: h who)))) (return 0))

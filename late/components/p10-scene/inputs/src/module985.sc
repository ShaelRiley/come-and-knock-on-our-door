; All limbs are raw unsigned16 bit patterns carried in signed SCI words.
; Comparisons split signs first. Negative bit-pattern words denote 32768..65535.
(method (p05WordLT a b)
 (if (< a 0) (if (>= b 0) (return 0)) else (if (< b 0) (return 1)))
 (if (< a b) (return 1)) (return 0))
(method (p05NZ slot)
 (if (!= [p05Words slot] 0) (return 1))
 (if (!= [p05Words (+ slot 1)] 0) (return 1)) (return 0))
(method (p05EQ a b)
 (if (!= [p05Words a] [p05Words b]) (return 0))
 (if (!= [p05Words (+ a 1)] [p05Words (+ b 1)]) (return 0)) (return 1))
(method (p05LT a b)
 (if (!= [p05Words a] [p05Words b]) (return (self p05WordLT: [p05Words a] [p05Words b])))
 (return (self p05WordLT: [p05Words (+ a 1)] [p05Words (+ b 1)])))
(method (p05LE a b) (if (self p05LT: b a) (return 0)) (return 1))
(method (p05Zero slot) (= [p05Words slot] 0) (= [p05Words (+ slot 1)] 0) (return 1))
(method (p05Copy target from)
 (= [p05Words target] [p05Words from]) (= [p05Words (+ target 1)] [p05Words (+ from 1)]) (return 1))
(method (p05Stamp slot) (return (self p05Copy: slot S_REVISION)))
(method (p05Working)

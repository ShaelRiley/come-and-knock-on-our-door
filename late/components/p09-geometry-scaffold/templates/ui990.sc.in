; New geometry scaffold. No story state, view state, receipt or ownership writes.
(method (h9UI mode &tmp c i obj top left bottom right x y scale jl jt jr jb label blocked)
 (if (or (not h9Host) (< mode 0) (> mode 1)) (return 0))
 (if (or (h9Host opening?) (h9Host paused?) (h9Host menuOpen?) (and (== mode 0) (h9Host motionPhase?))
  (h9Host onApron?) (h9Host uiPanel?) (h9Host bridgeReaderActive?)
  (h9Host uiFailure?) (h9Host bridgeFailure?) (!= (h9Host location?) 6)) (return 0))
 (= c (h9Host p08?)) (if (not c) (return 0))
 (if (not (c h8EveningCommitted:)) (return 0))
 ; Static tags use persistent history; temporary movement only blocks controls.
 (if (and (== mode 0) (not (c h8EveningReady:))) (return 0))
 (if (not (self h9Active:)) (return 0))
 (if (== mode 1)
  ; Draw behind the real actors. These small tag marks are newly authored.
  (for ((= i 7)) (< i 10) ((++ i))
   (= top (self h9Geo: i 1)) (= left (self h9Geo: i 2))
   (= bottom (self h9Geo: i 3)) (= right (self h9Geo: i 4))
   (= x (self h9Geo: i 5)) (= y (self h9Geo: i 6))
   (Graph 11 y x top (+ x 1) 1 0 0 0)
   (Graph 11 top left bottom right 1 0 0 0)
   (Graph 11 (+ top 1) (+ left 1) (- bottom 1) (- right 1) 1 1 0 0)
   (Graph 11 (+ top 3) (+ left 2) (+ top 4) (- right 2) 1 0 0 0)
   (Graph 11 (+ top 5) (+ left 2) (+ top 6) (- right 2) 1 0 0 0))
  (return 1))
 (= x (/ (h9Host motionX?) 64)) (= y (/ (h9Host motionY?) 64))
 (= scale (h9Host motionScale:))
 ; Conservative union over every original gait and mouth cel, plus one pixel.
 (= jl (- (+ (- x (/ (* 26 scale) 128)) (/ (* 2 scale) 128)) 1))
 (= jr (+ (+ (- x (/ (* 26 scale) 128)) (/ (* 51 scale) 128)) 1))
 (= jt (- (- y (/ (* 78 scale) 128)) 1))
 (= jb (+ (+ (- y (/ (* 78 scale) 128)) (/ (* 79 scale) 128)) 1))
 (for ((= i 0)) (< i 7) ((++ i))
  (= obj (self h9Geo: i 0)) (= top (self h9Geo: i 1)) (= left (self h9Geo: i 2))
  (= bottom (self h9Geo: i 3)) (= right (self h9Geo: i 4)) (= blocked 0)
  (if (and (< left jr) (> right jl) (< top jb) (> bottom jt)) (= blocked 1))
  (if (and (== (c h8ActorRoom: 4) 6) (< left 185) (> right 159) (< top 128) (> bottom 66)) (= blocked 1))
  (if (and (== (c h8ActorRoom: 7) 6) (< left 268) (> right 239) (< top 132) (> bottom 66)) (= blocked 1))
  (if (not blocked)
   (= label (self h9Label: obj))
   (if (== obj 397) (= label "FRONT VIEW"))
   (if (== obj 398) (= label "SIDE VIEW"))
   (h9Host uiAddControl: 1 obj top left bottom right label)))
 (return 1))

  (for ((= i 0)) (< i 3) ((++ i)) (if (self p12SlotAt: i) (return 0)))
  (for ((= slot 2)) (< slot P12_SERIAL_COUNT) ((++ slot)) (if (self p12Present: slot) (return 0))))
 ; Accepted model chronology: release<handoff relation, face, truthful intro, confetti and departure.
 (for ((= child 2)) (<= child 7) ((++ child))
  (= parent (- child 1)) (if (== child 7) (= parent 5))
  (if (and (!= child 6) (self p12Present: child))
   (if (or (not (self p12Present: parent)) (not (self p12Earlier: parent child))) (return 0))))
 (= observation 0)
 (if (self p12Complete: SOURCE_SELF_VIEW) (= observation (self p12DoneSlot: SOURCE_SELF_VIEW)))
 (if (self p12Complete: SOURCE_AUDIENCE_VIEW)
  (= done (self p12DoneSlot: SOURCE_AUDIENCE_VIEW))
  (if (or (== observation 0) (self p12Earlier: done observation)) (= observation done)))
 (if (self p12Present: 3) (if (or (== observation 0) (not (self p12Earlier: observation 3))) (return 0)))
 (if (self p12Present: 4)
  (= done (self p12DoneSlot: SOURCE_INTRODUCTION))
  (if (or (== observation 0) (not (self p12RackCorrect:)) (== done 0) (not (self p12Earlier: done 4))) (return 0)))
 (if (self p12Present: 6)
  (= done (self p12DoneSlot: SOURCE_CONFETTI))
  (if (or (== done 0) (not (self p12Present: 5)) (not (self p12Earlier: 5 done)) (not (self p12Earlier: done 6))) (return 0)))
 (if (self p12Present: 7)
  (= done (self p12DoneSlot: SOURCE_CLEANUP))
  (if (or (== done 0) (not (self p12Earlier: done 7))) (return 0)))
 (for ((= source 1)) (<= source 11) ((++ source))
  (= start (+ source 7)) (= base (self p12ReceiptBase: source)) (= previous start) (= gap 0)
  (for ((= i 0)) (< i (self p12Capacity: source)) ((++ i)) (= receipt (+ base i))
   (if (self p12Present: receipt)
    (if (or gap (not (self p12Present: start)) (not (self p12Earlier: start receipt)) (self p12Earlier: receipt previous)) (return 0))
    (= previous receipt)
   else (= gap 1)))
  (if (self p12Present: start)
   (if (or (not (self p12Present: 1)) (not (self p12Earlier: 1 start))) (return 0))
   (for ((= other 1)) (<= other 11) ((++ other))
    (if (and (!= source other) (self p12Equal: start (+ other 7))) (return 0))
    (for ((= j 0)) (< j (self p12Capacity: other)) ((++ j))
     (if (self p12Equal: start (+ (self p12ReceiptBase: other) j)) (return 0)))))
  (for ((= other (+ source 1))) (<= other 11) ((++ other))
   (for ((= i 0)) (< i (self p12Count: source)) ((++ i))
    (for ((= j 0)) (< j (self p12Count: other)) ((++ j))
     (if (self p12Equal: (+ base i) (+ (self p12ReceiptBase: other) j)) (return 0)))))
  (if (self p12Present: start)
   (if (== source SOURCE_INTRODUCTION)
    (if (or (not (self p12Earlier: 3 start)) (== observation 0) (not (self p12RackCorrect:))) (return 0)))
   (if (== source SOURCE_CONFETTI)
    (if (or (not (self p12Present: 5)) (not (self p12Earlier: 5 start))) (return 0)))
   (if (== source SOURCE_CLEANUP) (= done (self p12DoneSlot: SOURCE_CONFETTI))
    (if (or (== done 0) (not (self p12Earlier: done start))) (return 0)))))
 (return 1))
